Label {
    color: white;
    -unity-font-definition: resource('UI/Font/Orbitron-Medium');
    font-size: 22px;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}

.dpad-hold-hint {
    position: absolute;
    left: 66px; bottom: 39px;
    width: 46.667px; height: 46.667px;
    display: none;
    overflow: visible;
}
.dpad-hold-caption {
    position: absolute;
    left: 60px; top: 1.333px;
    height: 44px;
    white-space: nowrap;
    color: white;
    font-size: 26px;
    -unity-font-definition: resource('UI/Font/Orbitron-Medium');
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.stage {
    transform-origin: 50% 50%;
}

.map-frame-active > #CompassHost,
.map-frame-active > #LevelIndicator {
    visibility: hidden;
}

.hud-view {
    width: 1920px;
    height: 1080px;
    transform-origin: 0 0;
}

.edge-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.view-ring {
    width: 960px;
    height: 960px;
}

.inner-ring {
    width: 902px;
    height: 902px;
}

.outer-ring {
    width: 960px;
    height: 960px;
    transform-origin: 50% 50%;
}

.level-indicator {
    color: white;
    transform-origin: 50% 100%;
}

.level-degree {
    -unity-font-definition: resource('UI/Font/Orbitron-Regular');
    font-size: 20px;
    color: white;
}

.opening-control-hint {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: 0% 0%;
    flex-direction: column;
    align-items: flex-start;
}

.driving-control {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 2px 0;
    padding: 4px 3px;
    background-color: rgba(0, 0, 0, 0.86);
    border-radius: 4px;
}

.driving-control-key {
    width: 36px;
    height: 28px;
    margin-right: 7px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgb(212, 184, 84);
    border-radius: 5px;
    color: rgb(212, 184, 84);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.driving-control-stick {
    width: 28px;
    margin-right: 15px;
    border-radius: 50%;
}

.driving-control-action {
    font-size: 18px;
    white-space: nowrap;
}

.opening-signal-prompt {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    transform-origin: 50% 50%;
    align-items: flex-start;
}

.opening-signal-title {
    color: rgb(212, 184, 84);
}

.driving-control-key-wide {
    width: auto;
    min-width: 36px;
    padding-left: 6px;
    padding-right: 6px;
    white-space: nowrap;
}

.unstuck-failure {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 78px;
    translate: -50% 0;
    color: rgb(212, 184, 84);
    background-color: rgba(17, 18, 15, 0.94);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 184, 84);
    padding: 8px 20px;
    -unity-text-align: middle-center;
}

.status {
    width: 310px;
    height: 154px;
    transform-origin: 0 0;
}

.drive-damage-warning {
    display: none;
    position: absolute;
    left: 16px;
    top: 168px;
    padding: 7px 12px;
    background-color: rgba(0, 0, 0, 0.88);
    color: #D4B854;
    font-size: 19px;
    white-space: nowrap;
}

.integrity-ring {
    width: 100px;
    height: 100px;
}

.power-ring {
    width: 154px;
    height: 154px;
}

.power-percent {
    width: 82px;
    font-size: 21px;
    -unity-text-align: middle-left;
}

.power-name {
    width: 82px;
    font-size: 18px;
    -unity-text-align: middle-left;
}

.integrity-percent {
    width: 100px;
    height: 100px;
    font-size: 21px;
    -unity-text-align: middle-center;
}

.integrity-name {
    font-size: 18px;
}

.time {
    width: 230px;
    height: 230px;
    transform-origin: 100% 0;
}

.sound {
    width: 230px;
    height: 230px;
    transform-origin: 100% 0;
}

.time-orbit {
    width: 100%;
    height: 100%;
}

.date {
    -unity-font-definition: resource('UI/Font/Orbitron-Regular');
    color: rgb(212, 184, 84);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: pre;
}

.inventory {
    width: 570px;
    height: 780px;
}

.inventory-title {
    position: absolute;
    left: 90%;
    top: 14%;
    width: 9%;
    font-size: 14px;
    color: rgb(212, 184, 84);
    -unity-text-align: middle-center;
}

.cargo-mark {
    position: absolute;
    left: 93.5%;
    top: 11%;
    width: 12px;
    height: 12px;
    background-color: rgb(212, 184, 84);
}

.inventory-grid {
    width: 480px;
    height: 680px;
}

.inventory-slot {
    width: 50%;
    height: 25%;
    border-width: 1px;
    border-color: rgb(119, 119, 119);
    border-radius: 0;
    background-color: transparent;
    color: white;
    margin: 0;
    padding: 0;
    -unity-background-image-tint-color: white;
}

.inventory-slot:hover {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:focus {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:active {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:disabled {
    opacity: 1;
}

.inventory-selection {
    width: 252px;
    height: 175px;
}

.empty-item {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.coordinates {
    width: 370px;
    height: 75px;
    transform-origin: 100% 100%;
}

.coordinate-row {
    flex-direction: row;
    justify-content: flex-end;
    border-bottom-width: 1px;
    border-bottom-color: white;
    padding-bottom: 5px;
}

.coordinate-prefix {
    margin-right: 5px;
}

.coordinate-value {
    color: rgb(212, 184, 84);
    margin-right: 8px;
}

.altitude-row {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 4px;
}

.altitude-prefix {
    margin-right: 6px;
}

.compass-host {
    width: 330px;
    height: 54px;
    flex-shrink: 0;
    transform-origin: 50% 0;
    translate: -50% 0;
}

.compass-label {
    min-width: 64px;
    white-space: nowrap;
    -unity-text-align: lower-center;
    -unity-font-style: bold;
}

.compass-degree {
    -unity-font-definition: resource('UI/Font/Orbitron-Regular');
    -unity-font-style: normal;
}

.compass-pointer {
    width: 12px;
    height: 17px;
}
