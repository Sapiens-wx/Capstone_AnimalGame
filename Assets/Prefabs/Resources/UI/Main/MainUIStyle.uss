Label {
    color: white;
    -unity-font-definition: resource('UI/Font/Orbitron-Medium');
    font-size: 22px;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}

.stage {
    transform-origin: 50% 50%;
}

.hud-view {
    width: 1920px;
    height: 1080px;
    transform-origin: 0 0;
}

.edge-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.view-ring {
    width: 960px;
    height: 960px;
}

.inner-ring {
    width: 902px;
    height: 902px;
}

.outer-ring {
    width: 960px;
    height: 960px;
    transform-origin: 50% 50%;
}

.level-indicator {
    color: white;
    transform-origin: 50% 100%;
}

.level-degree {
    font-size: 22px;
    color: white;
}

.status {
    width: 310px;
    height: 154px;
    transform-origin: 0 0;
}

.integrity-ring {
    width: 100px;
    height: 100px;
}

.power-ring {
    width: 154px;
    height: 154px;
}

.power-percent {
    width: 82px;
    font-size: 21px;
    -unity-text-align: middle-left;
}

.power-name {
    width: 82px;
    font-size: 18px;
    -unity-text-align: middle-left;
}

.integrity-percent {
    width: 100px;
    height: 100px;
    font-size: 21px;
    -unity-text-align: middle-center;
}

.integrity-name {
    font-size: 18px;
}

.time {
    width: 230px;
    height: 230px;
    transform-origin: 100% 0;
}

.sound {
    width: 230px;
    height: 230px;
    transform-origin: 100% 0;
}

.time-orbit {
    width: 100%;
    height: 100%;
}

.date {
    -unity-font-definition: resource('UI/Font/Orbitron-Regular');
    color: rgb(212, 184, 84);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: pre;
}

.inventory {
    width: 570px;
    height: 780px;
}

.inventory-title {
    position: absolute;
    left: 90%;
    top: 14%;
    width: 9%;
    font-size: 14px;
    color: rgb(212, 184, 84);
    -unity-text-align: middle-center;
}

.cargo-mark {
    position: absolute;
    left: 93.5%;
    top: 11%;
    width: 12px;
    height: 12px;
    background-color: rgb(212, 184, 84);
}

.inventory-grid {
    width: 480px;
    height: 680px;
}

.inventory-slot {
    width: 50%;
    height: 25%;
    border-width: 1px;
    border-color: rgb(119, 119, 119);
    border-radius: 0;
    background-color: transparent;
    color: white;
    margin: 0;
    padding: 0;
    -unity-background-image-tint-color: white;
}

.inventory-slot:hover {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:focus {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:active {
    background-color: transparent;
    border-color: rgb(170, 170, 170);
}

.inventory-slot:disabled {
    opacity: 1;
}

.inventory-selection {
    width: 252px;
    height: 175px;
}

.empty-item {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.coordinates {
    width: 370px;
    height: 75px;
    transform-origin: 100% 100%;
}

.coordinate-row {
    flex-direction: row;
    justify-content: flex-end;
    border-bottom-width: 1px;
    border-bottom-color: white;
    padding-bottom: 5px;
}

.coordinate-prefix {
    margin-right: 5px;
}

.coordinate-value {
    color: rgb(212, 184, 84);
    margin-right: 8px;
}

.altitude-row {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 4px;
}

.altitude-prefix {
    margin-right: 6px;
}

.compass-host {
    width: 330px;
    height: 54px;
    flex-shrink: 0;
    transform-origin: 50% 0;
    translate: -50% 0;
}

.compass-label {
    min-width: 64px;
    white-space: nowrap;
    -unity-text-align: lower-center;
    -unity-font-style: bold;
}

.compass-degree {
    -unity-font-definition: resource('UI/Font/Orbitron-Regular');
    -unity-font-style: normal;
}

.compass-pointer {
    width: 12px;
    height: 17px;
}
