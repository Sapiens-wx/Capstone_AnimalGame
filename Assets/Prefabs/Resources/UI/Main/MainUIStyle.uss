Label {
    color: white;
    font-size: 22px;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}
.stage { transform-origin: 50% 50%; }
.hud-view { width: 1920px; height: 1080px; transform-origin: 0 0; }
.edge-hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.view-ring { width: 920px; height: 920px; }
.inner-ring { width: 862px; height: 862px; }
.outer-ring { width: 920px; height: 920px; transform-origin: 50% 50%; }
.level-indicator { color: white; transform-origin: 50% 100%; }
.level-degree { font-size: 22px; color: #D4B854; }
.status { width: 310px; height: 154px; transform-origin: 0 0; }
.integrity-ring { width: 154px; height: 154px; }
.power-ring { width: 110px; height: 110px; }
.power-percent { width: 75px; font-size: 21px; -unity-text-align: middle-right; }
.power-name { width: 82px; font-size: 18px; -unity-text-align: middle-right; }
.integrity-percent { font-size: 21px; }
.integrity-name { font-size: 18px; }
.time { width: 230px; height: 230px; transform-origin: 100% 0; }
.sound { width: 230px; height: 230px; transform-origin: 100% 0; }
.time-orbit { width: 100%; height: 100%; }
.date { color: #D4B854; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.inventory-entry { width: 110px; height: 86px; transform-origin: 0 100%; }
.inventory-entry-label { width: 45px; height: 52px; color: #D4B854; font-size: 40px; -unity-text-align: middle-center; }
.inventory { width: 570px; height: 780px; visibility: hidden; }
.inventory-title { position: absolute; left: 90%; top: 14%; width: 9%; font-size: 14px; color: #D4B854; -unity-text-align: middle-center; }
.cargo-mark { position: absolute; left: 93.5%; top: 11%; width: 12px; height: 12px; background-color: #D4B854; }
.inventory-grid { width: 480px; height: 680px; }
.inventory-slot {
    width: 50%;
    height: 25%;
    border-width: 1px;
    border-color: #777777;
    border-radius: 0;
    background-color: transparent;
    color: white;
    margin: 0;
    padding: 0;
    -unity-background-image-tint-color: white;
}
.inventory-slot:hover, .inventory-slot:focus, .inventory-slot:active { background-color: transparent; border-color: #AAAAAA; }
.inventory-slot:disabled { opacity: 1; }
.inventory-selection { width: 240px; height: 170px; }
.empty-item { flex-grow: 1; width: 100%; height: 100%; }
.coordinates { width: 370px; height: 75px; transform-origin: 100% 100%; }
.coordinate-row { flex-direction: row; justify-content: flex-end; border-bottom-width: 1px; border-bottom-color: white; padding-bottom: 5px; }
.coordinate-prefix { margin-right: 5px; }
.coordinate-value { color: #D4B854; margin-right: 8px; }
.altitude-row { flex-direction: row; justify-content: flex-end; padding-top: 4px; }
.altitude-prefix { margin-right: 6px; }
.compass-host { width: 330px; height: 54px; flex-shrink: 0; transform-origin: 50% 0; translate: -50% 0; }
.compass-label { min-width: 64px; white-space: nowrap; -unity-text-align: lower-center; -unity-font-style: bold; }
.compass-pointer { width: 12px; height: 17px; }
