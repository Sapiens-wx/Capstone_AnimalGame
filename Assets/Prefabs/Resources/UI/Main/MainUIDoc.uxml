<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hud="AnimalGame.MainUI" xmlns:inventory="AnimalGame.MainUI.Inventory" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefabs/Resources/UI/Main/MainUIStyle.uss?fileID=7433441132597879392&amp;guid=b617651db47b0724fa851c04f244ad70&amp;type=3#MainUIStyle" />
    <ui:VisualElement name="Stage" picking-mode="Ignore" class="stage" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="HudView" picking-mode="Ignore" class="hud-view" style="position: absolute;">
            <hud:ViewRingGroupElement name="ViewRing" line-width="5" picking-mode="Ignore" class="view-ring" style="position: absolute; left: 480px; top: 60px;">
                <hud:ViewRingElement name="OuterRing" ticks="true" radius-inset="12" tick-length="28" fill-inset="17" class="outer-ring" style="position: absolute; left: 0; top: 0;" />
                <hud:ViewRingElement name="InnerRing" class="inner-ring" style="position: absolute; left: 29px; top: 29px;" />
            </hud:ViewRingGroupElement>
            <ui:VisualElement name="Inventory" picking-mode="Ignore" class="inventory" style="position: absolute; left: -508px; top: 202px; height: 746px;">
                <inventory:InventoryOutlineElement class="fill" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
                <ui:VisualElement name="InventoryGrid" picking-mode="Ignore" class="inventory-grid" style="position: absolute; left: 32px; top: 55px; height: 660px; width: 484px;" />
                <inventory:InventorySelectionElement name="InventorySelection" class="inventory-selection" style="position: absolute; left: 27px; top: 50px;" />
                <ui:VisualElement style="flex-grow: 0; height: 254px; width: 52px; position: absolute; top: 82px; left: 514px; border-right-width: 2px; border-right-color: rgb(212, 184, 84); border-bottom-right-radius: 2px; border-top-right-radius: 2px;">
                    <ui:Label text="CARGO" name="Label-Cargo" class="inventory-title" style="rotate: 90deg; top: 86px; left: -34px; -unity-font-style: bold; font-size: 26px; height: 29px; width: 134px;" />
                    <ui:VisualElement picking-mode="Ignore" name="Square" class="cargo-mark" style="height: 18px; width: 20px; top: 15px; left: 23px;" />
                    <ui:Label text="*" name="Label-AStar" class="inventory-title" style="rotate: 0; top: 168px; left: 16px; -unity-font-style: normal; font-size: 47px; height: 29px; width: 35px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="EdgeHud" picking-mode="Ignore" class="edge-hud">
            <ui:VisualElement name="Status" picking-mode="Ignore" class="status" style="position: absolute; left: 54px; top: 52px;">
                <hud:CircularProgressElement name="PowerRing" outside="true" line-width="7" length="16" class="power-ring" style="position: absolute; left: 0; top: 0;" />
                <hud:CircularProgressElement name="IntegrityRing" notch-depth="10" line-width="3" class="integrity-ring" style="position: absolute; left: 27px; top: 27px;" />
                <ui:Label name="PowerPercent" text="100%" class="power-percent" style="position: absolute; left: 125px; top: 20px;" />
                <ui:Label text="Power" class="power-name" style="position: absolute; left: 125px; top: 46px;" />
                <ui:Label name="IntegrityPercent" text="100%" class="integrity-percent" style="position: absolute; left: 27px; top: 27px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Time" picking-mode="Ignore" class="time" style="position: absolute; right: 28px; top: 19px;">
                <hud:TimeOrbitElement name="TimeOrbit" line-width="4" tick-length="12" radius="77" dash-gap="14" class="time-orbit" style="position: absolute; left: 0; top: 0;" />
                <ui:Label name="Date" text="2026_01_01" class="date" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 20px;" />
            </ui:VisualElement>
            <hud:SoundElement name="Sound" line-width="4" line-length="45.2" class="sound" style="position: absolute; right: 278px; top: 67px; height: 136px; width: 162px;" />
            <ui:VisualElement name="Coordinates" picking-mode="Ignore" class="coordinates" style="position: absolute; right: 68px; bottom: 30px; width: 258px;">
                <ui:VisualElement name="VisualElement" class="coordinate-row" style="border-bottom-width: 0;">
                    <ui:Label name="LatitudeHemisphere" text="N" class="coordinate-prefix" />
                    <ui:Label name="Latitude" text="--.-----°" class="coordinate-value" />
                    <ui:Label name="LongitudeHemisphere" text="W" class="coordinate-prefix" />
                    <ui:Label name="Longitude" text="--.-----°" class="coordinate-value" />
                </ui:VisualElement>
                <AnimalGame.RobotMap.PhotoResultLineElement end-point="258.7,0" start-point="10.12,0" />
                <ui:VisualElement class="altitude-row">
                    <ui:Label text="Altitude" class="altitude-prefix" />
                    <ui:Label name="Altitude" text="--m" class="coordinate-value" />
                </ui:VisualElement>
                <AnimalGame.RobotMap.PhotoResultLineElement end-point="0,15" style="left: auto; right: 0; top: 32px; height: 42px; width: 0; position: absolute;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <hud:HudFrameElement name="Frame" margin="20" corner-chamfer="46" top-notch-width="556.1" top-notch-height="34.3" bottom-notch-width="136.5" bottom-notch-height="47.7" notch-chamfer="10.15" top-notch-chamfer="77.6" bottom-notch-chamfer="42.9" class="fill" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <hud:CompassHostElement name="CompassHost" picking-mode="Ignore" class="compass-host" style="position: absolute; left: 50%; width: 714px; height: 58px; top: 0; translate: -50% 0;">
            <hud:CompassElement name="Compass" line-width="4.71" degree-font-size="17" direction-font-size="27.4" baseline-offset="28.9" display-range="262.2" class="fill" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-bottom-width: 0; border-bottom-color: rgb(0, 0, 0); border-bottom-left-radius: 0; border-bottom-right-radius: 0;" />
            <hud:CompassPointerElement class="compass-pointer" style="position: absolute; left: 50%; bottom: 1px; translate: -50% 0;" />
        </hud:CompassHostElement>
        <hud:LevelIndicatorElement name="LevelIndicator" width="4" length="157.4" height="61.5" center-margin="39.6" degree="0" class="level-indicator" style="position: absolute; left: 50%; top: auto; width: 164px; height: 66px; bottom: 0; right: auto; translate: -50% 0;" />
    </ui:VisualElement>
</ui:UXML>
