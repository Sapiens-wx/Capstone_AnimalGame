<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:archive="AnimalGame.Animals.UI" editor-extension-mode="False">
    <Style src="project://database/Assets/Prefabs/Resources/UI/AnimalCatalog/AnimalArchive.uss?fileID=7433441132597879392&amp;guid=1e2249d0c9d4e954b9e38285620aee36&amp;type=3#AnimalArchive" />
    <ui:VisualElement name="archive-viewport" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;">
        <ui:VisualElement name="archive-shell" style="border-top-width: 0; border-right-width: 0;">
            <archive:ArchiveGridElement name="archive-grid" picking-mode="Ignore" />
            <ui:VisualElement class="tabs" style="display: flex;">
                <ui:Button name="photos-tab" class="active-tab tab-action">
                    <ui:Label text="LB" picking-mode="Ignore" class="key-badge" />
                    <ui:Label text="Photos" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="catalog-tab" class="tab-action">
                    <ui:Label text="Catalog" picking-mode="Ignore" />
                    <ui:Label text="RB" picking-mode="Ignore" class="key-badge" />
                </ui:Button>
                <ui:VisualElement name="species-navigation" style="display: none;">
                    <ui:Button name="species-previous" class="species-neighbor">
                        <ui:Label text="&lt;" picking-mode="Ignore" class="neighbor-arrow" />
                        <ui:Label text="LT" picking-mode="Ignore" class="neighbor-key" />
                        <ui:Label name="previous-species-name" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="species-next" class="species-neighbor">
                        <ui:Label name="next-species-name" picking-mode="Ignore" />
                        <ui:Label text="RT" picking-mode="Ignore" class="neighbor-key" />
                        <ui:Label text="&gt;" picking-mode="Ignore" class="neighbor-arrow" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="body">
                <ui:VisualElement class="sidebar">
                    <ui:Button name="main-catalog" class="photo-action" style="display: none;">
                        <ui:Label text="Y" picking-mode="Ignore" class="photo-action-circle" />
                        <ui:Label text="Main Catalog" picking-mode="Ignore" class="photo-action-caption" />
                        <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                    </ui:Button>
                    <archive:ArchiveHeadingElement name="sidebar-title" text="COLLECTION" end-length="8" bottom-offset="0" class="heading" />
                    <ui:Button name="previous" text="LT" class="key-action" style="width: 44px; height: auto;" />
                    <ui:ScrollView name="collections" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
                    <ui:ScrollView name="catalog-sidebar" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="display: none;" />
                    <ui:Button name="next" text="RT" class="key-action" style="width: 44px; height: auto;" />
                    <ui:Label name="local-count" />
                </ui:VisualElement>
                <ui:VisualElement class="workspace" style="border-right-color: rgb(155, 156, 147); border-right-width: 1px;">
                    <ui:VisualElement name="photos-page" class="page row" style="border-right-color: rgb(155, 156, 147); border-right-width: 0; display: flex;">
                        <ui:VisualElement name="photo-index">
                            <ui:VisualElement class="row index-header">
                                <archive:ArchiveHeadingElement text="PHOTO INDEX" end-length="8" bottom-offset="0" class="heading" />
                                <ui:Button name="photo-sort" text="Newest first ↓" />
                            </ui:VisualElement>
                            <ui:Label text="RIGHT STICK  SELECT PHOTO" class="hint" />
                            <ui:VisualElement name="photo-tiles" />
                        </ui:VisualElement>
                        <ui:VisualElement name="photo-preview">
                            <ui:VisualElement name="photo-heading">
                                <ui:Label name="photo-name" class="title" />
                                <archive:ArchiveScientificNameElement name="photo-scientific" bottom-line-ratio="0.4" />
                            </ui:VisualElement>
                            <ui:VisualElement class="preview-body">
                                <archive:ArchivePhotoImageElement name="photo-image" scale-mode="ScaleToFit" />
                                <ui:VisualElement class="photo-information">
                                    <ui:VisualElement class="photo-date-row">
                                        <ui:Label name="photo-date" />
                                        <ui:VisualElement name="photo-uploaded" class="photo-uploaded" style="display: none;">
                                            <ui:Label text="✓" class="uploaded-check" />
                                            <ui:Label text="UPLOADED" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="photo-location-row">
                                        <ui:Label text="LOCATION" class="photo-location-title" />
                                        <ui:Label name="photo-region" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="photo-metadata">
                                        <ui:VisualElement class="photo-fact">
                                            <ui:Label text="Captured:" class="photo-field" />
                                            <ui:Label name="photo-captured" class="photo-value" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="photo-fact">
                                            <ui:Label text="Altitude:" class="photo-field" />
                                            <ui:Label name="photo-altitude" class="photo-value" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="photo-fact">
                                            <ui:Label text="Position:" class="photo-field" />
                                            <ui:Label name="photo-position" class="photo-value" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="photo-fact">
                                            <ui:Label text="Camera:" class="photo-field" />
                                            <ui:Label name="photo-camera" class="photo-value" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:Button name="photo-open" class="photo-action">
                                        <ui:Label text="A" picking-mode="Ignore" class="photo-action-circle" />
                                        <ui:Label text="VIEW PHOTOGRAPH" picking-mode="Ignore" class="photo-action-caption" />
                                        <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                                    </ui:Button>
                                    <ui:VisualElement name="photo-navigation" class="photo-navigation">
                                        <ui:Button name="photo-previous" class="photo-action">
                                            <ui:Label text="←" picking-mode="Ignore" class="photo-action-circle" />
                                            <ui:Label text="Previous" picking-mode="Ignore" class="photo-action-caption" />
                                            <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                                        </ui:Button>
                                        <ui:Button name="photo-next" class="photo-action">
                                            <ui:Label text="→" picking-mode="Ignore" class="photo-action-circle" />
                                            <ui:Label text="Next" picking-mode="Ignore" class="photo-action-caption" />
                                            <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:Button name="photo-catalog" class="photo-action">
                                        <ui:Label text="Y" picking-mode="Ignore" class="photo-action-circle" />
                                        <ui:Label text="VIEW CATALOG" picking-mode="Ignore" class="photo-action-caption" />
                                        <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                                    </ui:Button>
                                    <ui:Button name="photo-delete" class="photo-action">
                                        <archive:ArchiveHoldCircleElement name="photo-delete-progress" text="X" picking-mode="Ignore" class="photo-action-circle" />
                                        <ui:Label text="Delete Image" picking-mode="Ignore" class="photo-action-caption" />
                                        <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="catalog-page" class="page" style="display: none;" />
                    <ui:VisualElement name="species-page" class="page" style="display: none;">
                        <ui:Label name="catalog-name" class="title" />
                        <archive:ArchiveScientificNameElement name="catalog-scientific" bottom-line-ratio="0.1" />
                        <ui:Label name="catalog-region" />
                        <ui:ScrollView name="catalog-details">
                            <ui:VisualElement class="row catalog-columns">
                                <ui:VisualElement class="catalog-column narrow">
                                    <archive:CatalogHeadingElement text="Classification" />
                                    <ui:Label name="classification" />
                                    <archive:CatalogHeadingElement text="Lifespan" />
                                    <ui:Label name="lifespan" />
                                    <archive:CatalogHeadingElement text="Conservation Status (21st c.)" />
                                    <ui:Label name="conservation" />
                                </ui:VisualElement>
                                <ui:VisualElement class="catalog-column illustration-column">
                                    <archive:CatalogHeadingElement text="Physical Characteristics" />
                                    <ui:Label name="physical" />
                                    <ui:Image name="catalog-illustration" scale-mode="ScaleToFit" style="display: none;" />
                                </ui:VisualElement>
                                <ui:VisualElement class="catalog-column narrow catalog-right-column">
                                    <archive:CatalogHeadingElement text="Distribution" flip="true" />
                                    <ui:Image name="distribution-map" scale-mode="ScaleToFit" style="display: none;" />
                                    <ui:Label name="distribution" />
                                    <archive:CatalogHeadingElement text="Habitat" flip="true" />
                                    <ui:Label name="habitat" />
                                    <archive:CatalogHeadingElement text="Diet" flip="true" />
                                    <ui:Label name="diet" />
                                    <archive:CatalogHeadingElement text="Social Behavior" flip="true" />
                                    <ui:Label name="social" />
                                    <archive:CatalogHeadingElement text="Activity Pattern" flip="true" />
                                    <ui:Label name="activity" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <archive:CatalogHeadingElement text="Description" />
                            <ui:Label name="description" />
                        </ui:ScrollView>
                        <ui:Button name="species-photos" class="photo-action action-key-right">
                            <ui:Label text="View Animal Photo" picking-mode="Ignore" class="photo-action-caption" />
                            <ui:Label text="X" picking-mode="Ignore" class="photo-action-circle" />
                            <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="footer" style="border-right-width: 0; border-right-color: rgb(155, 156, 147);">
                        <ui:Label name="record-count" />
                        <ui:VisualElement name="species-recognition" style="display: none;">
                            <ui:Label text="Species Recognition" />
                            <ui:VisualElement name="recognition" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="back" class="photo-action">
                            <ui:Label text="B" picking-mode="Ignore" class="photo-action-circle" />
                            <ui:Label text="Last Menu" picking-mode="Ignore" class="photo-action-caption" />
                            <ui:VisualElement picking-mode="Ignore" class="photo-action-underline" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tab-selection" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
