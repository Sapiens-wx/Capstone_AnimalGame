:root { color: #e7e7df; font-size: 19px; -unity-font-definition: resource('UI/Photo/GeosansLightStatic'); }
#archive-viewport { background-color: #060706; }
#archive-shell { position: absolute; left: 25px; right: 25px; top: 18px; bottom: 24px; background-color: #060706; border-width: 1px; border-color: #9b9c93; }
#archive-grid { position: absolute; left: 300px; right: 0; top: 70px; bottom: 75px; }
.row, .tabs, .body, .footer, .preview-body { flex-direction: row; }
.tabs { height: 70px; background-color: #060706; }
#photos-tab, #catalog-tab { color: #e7e7df; font-size: 34px; width: 235px; border-color: #9b9c93; border-width: 1px; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; }
.tab-action > Label { white-space: nowrap; margin-left: 5px; margin-right: 5px; flex-shrink: 0; }
.tab-action > .key-badge { color: #D4B854; border-width: 1px; border-color: white; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; }
#tab-selection { position: absolute; width: 235px; height: 10px; left: 1px; top: 66px; background-color: #D4B854; }
.body { flex-grow: 1; min-height: 0; border-top-width: 1px; border-top-color: #a7a79b; }
.sidebar { width: 280px; padding: 18px; border-right-width: 1px; border-right-color: #9b9c93; background-color: #060706; }
#collections { flex-grow: 0; flex-shrink: 1; min-height: 0; max-height: 100%; margin-top: 14px; margin-bottom: 14px; }
#sidebar-title, #previous, #next, #local-count { flex-shrink: 0; }
.collection { white-space: normal; min-height: 40px; -unity-text-align: middle-left; margin-bottom: 9px; padding-left: 12px; border-width: 1px; border-color: #36372e; }
.photo-collection { flex-direction: column; align-items: stretch; justify-content: space-between; padding: 12px; }
.photo-collection > Label { margin: 0; padding: 0; flex-shrink: 0; }
.collection-name { -unity-text-align: upper-left; }
.photo-collection > .collection-records { font-size: 9px; -unity-text-align: lower-left; margin-top: 8px; }
#local-count { white-space: normal; margin-top: 25px; padding-top: 18px; border-top-width: 1px; border-top-color: #47483f; font-size: 17px; }
.workspace { flex-grow: 1; min-width: 0; }
.page { flex-grow: 1; min-height: 0; padding: 20px; }
#photo-index { width: 47%; padding-right: 18px; border-right-width: 1px; border-right-color: #74756c; }
.index-header { justify-content: space-between; align-items: center; min-height: 40px; flex-shrink: 0; }
#photo-sort { font-size: 16px; }
.hint { font-size: 15px; margin-top: 10px; margin-bottom: 16px; }
#photo-tiles { flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 0; }
.photo-tile { width: 31.5%; height: 48%; margin-right: 1.5%; margin-bottom: 2%; border-width: 1px; border-color: #5b5c52; padding: 4px; justify-content: flex-start; }
.photo-tile-picture { width: 100%; align-self: center; flex-shrink: 0; }
.photo-tile-image { width: 100%; flex-shrink: 0; }
.photo-tile Label { white-space: normal; font-size: 15px; -unity-text-align: upper-left; margin: 0; padding: 0; flex-shrink: 0; }
.photo-tile .photo-tile-number { position: absolute; left: 0; bottom: 0; border-top-width: 1px; border-right-width: 1px; border-color: white; background-color: black; color: white; }
.photo-tile .photo-tile-name { font-size: 24px; -unity-font-style: bold; margin-top: 2px; padding-top: 4px; padding-bottom: 4px; }
.photo-tile .photo-tile-date { margin-top: 1px; color: white; }
.selected { border-color: #D4B854; border-width: 2px; color: #D4B854; background-color: rgba(212,184,84,0.06); }
.unity-button.selected { background-color: rgba(212,184,84,0.06); }
.photo-tile:hover { background-color: transparent; }
.photo-tile.selected { color: white; background-color: transparent; border-color: #8B805B; border-bottom-color: #D4B854; }
.photo-tile.selected .photo-tile-name { color: #D4B854; }
#photo-preview { flex-grow: 1; min-width: 0; padding-left: 20px; }
.title { font-size: 43px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
.scientific { font-size: 26px; padding: 5px; border-bottom-width: 1px; border-bottom-color: #929387; margin-bottom: 20px; }
#photo-heading { margin-bottom: 16px; flex-shrink: 0; }
.preview-body { flex-grow: 1; min-height: 0; align-items: flex-start; }
#photo-image { width: 48%; flex-shrink: 0; margin-right: 15px; border-width: 1px; border-color: #88897c; border-radius: 0; }
.photo-information { flex-grow: 1; flex-basis: 0; min-width: 0; }
.photo-scientific-name { font-size: 26px; white-space: normal; border-top-width: 1px; border-left-width: 1px; border-color: #929387; padding: 5px 8px; }
.photo-date-row, .photo-location-row { flex-direction: row; justify-content: space-between; align-items: center; padding-top: 12px; padding-bottom: 10px; }
.photo-date-row { font-size: 15px; display: none; }
.photo-location-row { padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: #929387; }
.photo-uploaded { flex-direction: row; align-items: center; flex-shrink: 0; }
.uploaded-check { margin-right: 5px; }
.photo-location-title { color: #D4B854; font-size: 22px; flex-shrink: 0; }
#photo-region { white-space: normal; -unity-text-align: middle-right; margin-left: 12px; min-width: 0; }
#photo-metadata { margin-top: 10px; font-size: 17px; }
.photo-fact { flex-direction: row; align-items: flex-start; margin-bottom: 6px; }
.photo-field { width: 86px; flex-shrink: 0; }
.photo-value { flex-grow: 1; flex-basis: 0; min-width: 0; white-space: normal; }
#photo-open { margin-top: 20px; }
.photo-navigation { flex-direction: row; flex-wrap: wrap; margin-top: 20px; }
.photo-action { flex-direction: row; align-items: center; align-self: flex-start; padding: 0 0 1px 0; margin-right: 18px; margin-bottom: 10px; white-space: nowrap; }
.photo-action > Label { margin: 0; padding: 0; flex-shrink: 0; }
.photo-action > .photo-action-circle { width: 30px; height: 30px; border-width: 1px; border-color: white; border-radius: 15px; color: #D4B854; font-size: 20px; -unity-text-align: middle-center; margin-right: 8px; }
.photo-action-caption { font-size: 17px; }
.photo-action-underline { position: absolute; left: 15px; right: 0; bottom: 0; height: 1px; background-color: white; }
#photo-catalog { margin-top: 8px; }
#photo-preview.inspection { padding-left: 0; }
#photo-preview.inspection #photo-heading { margin-bottom: 0; }
#photo-preview.inspection .preview-body { align-items: stretch; }
#photo-preview.inspection .photo-information { border-left-width: 1px; border-left-color: white; padding-left: 18px; }
#photo-preview.inspection .photo-date-row { display: flex; }
#photo-preview.inspection #photo-image { width: 50%; height: 100%; border-width: 0; }
.heading { color: #D4B854; font-size: 22px; margin-top: 6px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: #8a783c; white-space: normal; }
.footer { height: 72px; flex-shrink: 0; border-top-width: 1px; border-top-color: #939487; padding: 18px; justify-content: space-between; align-items: center; background-color: #060706; }
.footer .photo-action { align-self: center; margin: 0; }
#back { margin-left: auto; }
Button { color: #e7e7df; background-color: transparent; border-width: 0; border-radius: 0; padding: 6px; margin: 0; }
Button:hover { color: #D4B854; background-color: rgba(212,184,84,0.07); }
Button:focus { border-color: #D4B854; }
Button:disabled { opacity: 0.35; }
.collection { border-left-width: 0; background-image: none; }
.collection.selected { border-width: 1px; border-color: #9b9c93; border-left-width: 2px; border-left-color: #D4B854; }
#catalog-details { flex-grow: 1; min-height: 0; margin-top: 12px; }
#catalog-details .unity-scroll-view__content-container { width: 100%; }
.catalog-columns { min-height: 400px; }
.catalog-column { padding: 14px; }
.catalog-column Label, #description { white-space: normal; }
.narrow { width: 27%; }
.illustration-column { width: 46%; }
#catalog-illustration { height: 320px; }
#distribution-map { height: 140px; }
#species-photos { align-self: flex-end; margin-top: 18px; }
.action-key-right > .photo-action-circle { margin-left: 8px; margin-right: 0; }
.action-key-right > .photo-action-underline { left: 0; right: 15px; }
#main-catalog { align-self: flex-start; flex-shrink: 0; margin-bottom: 20px; }
#main-catalog .photo-action-caption { font-size: 25px; }
#catalog-sidebar { flex-grow: 1; min-height: 0; }
.catalog-sidebar-item, .catalog-sidebar-item:hover, .catalog-sidebar-item:focus { min-height: 0; flex-shrink: 0; margin: 0; padding: 16px; border-width: 1px; border-color: white; background-color: black; background-image: none; color: white; font-size: 24px; white-space: normal; -unity-text-align: middle-left; }
.catalog-sidebar-item:disabled { opacity: 1; }
.catalog-mode .sidebar { padding: 16px 12px 72px; border-right-width: 0; }
.catalog-mode .workspace { padding: 16px 16px 0 0; }
.catalog-mode .footer { border-top-width: 0; padding-left: 0; padding-right: 0; }
#catalog-page, #species-page { border-width: 1px; border-color: white; }
#catalog-region { display: none; }
#catalog-scientific { flex-shrink: 0; }
.catalog-heading { color: #D4B854; font-size: 26px; margin-top: 12px; margin-bottom: 6px; padding-left: 6px; padding-bottom: 7px; align-self: flex-start; max-width: 100%; white-space: normal; flex-shrink: 0; }
.catalog-right-column { align-items: flex-end; }
.catalog-right-column > Label { -unity-text-align: upper-right; }
.catalog-right-column > .catalog-heading { align-self: flex-end; }
#species-recognition { flex-grow: 1; min-width: 0; flex-direction: row; align-items: center; margin-right: 30px; }
#species-recognition > Label { color: #D4B854; font-size: 23px; margin-right: 20px; flex-shrink: 0; }
#recognition { height: 24px; flex-grow: 1; border-width: 1px; border-color: white; background-color: black; }
#species-navigation { margin-left: auto; width: 52%; min-width: 0; flex-direction: row; border-width: 1px; border-color: white; }
.species-neighbor { width: 50%; min-width: 0; flex-direction: row; align-items: center; color: white; font-size: 20px; }
.species-neighbor > Label { margin-left: 5px; margin-right: 5px; }
#species-next { justify-content: flex-end; }
.neighbor-key { color: #D4B854; border-width: 1px; border-color: white; padding: 0 5px; flex-shrink: 0; }
.neighbor-arrow { font-size: 30px; flex-shrink: 0; }
#previous-species-name, #next-species-name { min-width: 0; white-space: normal; }
.species-neighbor:disabled { opacity: 1; }
.species-neighbor.unavailable > Label { color: black; }

.heading.archive-heading { border-width: 0; align-self: flex-start; white-space: nowrap; }
.key-action { color: #D4B854; border-width: 1px; border-color: white; font-size: 20px;-unity-font-style: bold; -unity-text-align: middle-center; padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; }
.hint.key-action { justify-content: flex-start; }
