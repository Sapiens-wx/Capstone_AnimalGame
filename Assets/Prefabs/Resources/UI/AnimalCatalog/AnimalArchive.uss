:root { color: #e7e7df; font-size: 19px; -unity-font-definition: resource('UI/Photo/GeosansLightStatic'); }
#archive-viewport { background-color: #060706; }
#archive-shell { position: absolute; left: 50px; right: 50px; top: 45px; bottom: 26px; background-color: black; border-width: 1px; border-color: #9b9c93; }
#archive-grid { position: absolute; left: 298px; right: 0; top: 64px; bottom: 68px; }
.row, .tabs, .body, .footer, .preview-body { flex-direction: row; }
.tabs { height: 64px; background-color: black; }
#photos-tab, #catalog-tab { color: #e7e7df; font-size: 48px; width: 235px; border-color: white; border-width: 1px; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; }
.tab-action > Label { white-space: nowrap; margin-left: 5px; margin-right: 5px; flex-shrink: 0; }
.key-badge, .neighbor-key { flex-shrink: 0; color: #D4B854; background-color: black; border-width: 1px; border-color: white; border-radius: 0; font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; transform-origin: 50% 50%; }
#tab-selection { position: absolute; height: 8px; translate: 0 -50%; background-color: #D4B854; }
#tab-selection-border { position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; }
.body { flex-grow: 1; min-height: 0; border-top-width: 1px; border-top-color: #a7a79b; }
.sidebar { width: 298px; padding: 40.5px 16px 114px; border-right-width: 0; background-color: black; }
.sidebar.species-list-visible { padding-bottom: 30px; }
#collections { flex-grow: 1; min-height: 0; margin: 0; }
#sidebar-title { flex-shrink: 0; }
.workspace { flex-grow: 1; min-width: 0; padding: 16px 16px 0 0; }
.page { flex-grow: 1; min-height: 0; padding: 20px; border-width: 1px; border-color: white; }
#photo-index { flex-shrink: 0; padding: 28px 20px 20px; }
.index-header { justify-content: space-between; align-items: center; min-height: 40px; flex-shrink: 0; }
.index-header > .catalog-heading { height: 42px; margin: 0; white-space: nowrap; translate: 6px -8px; }
#photo-sort { font-size: 16px; }
.hint { font-size: 15px; margin-top: 10px; margin-bottom: 16px; }
#photo-tiles { flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 0; }
.photo-tile { width: 31.5%; height: 49%; margin-right: 1.5%; margin-bottom: 1%; border-width: 1px; border-color: #5b5c52; padding: 4px; justify-content: flex-start; }
.photo-tile-picture { width: 100%; align-self: center; flex-shrink: 0; }
.photo-tile-image { width: 100%; flex-shrink: 0; }
.photo-tile Label { white-space: normal; font-size: 15px; -unity-text-align: upper-left; margin: 0; padding: 0; flex-shrink: 0; }
.photo-tile .photo-tile-number { position: absolute; left: 0; bottom: 0; border-top-width: 1px; border-right-width: 1px; border-color: white; background-color: black; color: white; }
.photo-tile .photo-tile-name { font-size: 24px; -unity-font-style: bold; margin-top: 2px; padding-top: 4px; padding-bottom: 4px; }
.photo-tile .photo-tile-date { margin-top: 1px; color: white; }
.selected { border-color: #D4B854; border-width: 2px; color: #D4B854; background-color: rgba(212,184,84,0.06); }
.unity-button.selected { background-color: rgba(212,184,84,0.06); }
.photo-tile:hover { background-color: transparent; }
.photo-tile.selected { color: white; background-color: transparent; border-color: #D4B854; }
.photo-tile.selected .photo-tile-name { color: #D4B854; }
#photo-preview { flex-grow: 1; min-width: 0; }
.title { font-size: 43px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
#photo-name { font-size: 56px; }
#photo-scientific { font-size: 36px; white-space: nowrap; border-color: white; }
.scientific { font-size: 26px; padding: 5px; border-bottom-width: 1px; border-bottom-color: #929387; margin-bottom: 20px; }
#photo-heading { margin-bottom: 0; flex-shrink: 0; translate: 0 -12px; }
.preview-body { flex-grow: 1; min-height: 0; align-items: stretch; }
#photo-frame { height: 100%; flex-shrink: 0; overflow: hidden; }
#photo-image, #photo-outgoing { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#photo-outgoing { display: none; }
.photo-information { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 90px 20px 20px 19px; }
.photo-scientific-name { font-size: 26px; white-space: normal; border-left-width: 1px; border-color: #929387; padding: 10px 8px; }
.photo-uploaded { flex-direction: row; align-items: center; align-self: flex-end; flex-shrink: 0; font-size: 28px; color: #D4B854; padding: 12px 0 10px; }
.photo-tile > .photo-tile-uploaded { color: #D4B854; }
#photo-metadata { margin-top: 10px; padding: 10px 0; font-size: 28px; border-top-width: 1px; border-bottom-width: 1px; border-color: #929387; }
.photo-fact { flex-direction: row; align-items: flex-start; margin-bottom: 6px; }
.photo-field { width: 152px; flex-shrink: 0; color: #D4B854; }
.photo-value { flex-grow: 1; flex-basis: 0; min-width: 0; white-space: normal; }
#photo-open { margin-top: 20px; }
.photo-navigation { flex-direction: row; flex-wrap: wrap; margin-top: 20px; }
.photo-action { flex-direction: row; align-items: center; align-self: flex-start; padding: 0; margin-right: 18px; margin-bottom: 10px; white-space: nowrap; overflow: visible; }
.sidebar-species-step { height: 42px; align-self: stretch; flex-shrink: 0; margin: 0; }
.photo-action > .photo-action-circle, .photo-action > .photo-action-caption { margin: 0; padding: 0; flex-shrink: 0; }
.photo-action > .photo-action-circle { width: 42px; height: 42px; border-width: 4px; border-color: #D4B854; border-radius: 50%; color: white; background-color: black; font-size: 28px; -unity-font-style: normal; -unity-text-align: middle-center; -unity-font-definition: resource('UI/Photo/GeosansLightStatic'); margin-right: 8px; transform-origin: 50% 50%; }
.photo-action > .key-badge { height: 42px; flex-shrink: 0; margin: 0 8px 0 0; }
.photo-action-caption { font-size: 28px; -unity-font-style: bold; color: #e7e7df; }
#photo-previous > .photo-action-circle, #photo-next > .photo-action-circle { padding-bottom: 6px; }
/* Keep the paint area nonzero after panel scaling; the stroke itself stays 1px. */
.photo-action-underline { position: absolute; left: 15px; right: 0; bottom: 0; height: 4px; }
#photo-open > .photo-action-underline, #photo-previous > .photo-action-underline, #photo-next > .photo-action-underline, #photo-catalog > .photo-action-underline, #photo-delete > .photo-action-underline { left: 21px; }
#photo-open > .photo-action-underline, #photo-catalog > .photo-action-underline, #photo-delete > .photo-action-underline { right: -14px; }
#species-photos > .photo-action-underline { bottom: 1px; }
#photo-delete > .photo-action-underline { bottom: 2px; }
#photo-catalog, #photo-delete { margin-top: 8px; }
.heading { color: #D4B854; font-size: 22px; margin-top: 6px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: #D4B854; white-space: normal; }
.footer { height: 68px; flex-shrink: 0; border-top-width: 0; padding: 12px 0; justify-content: space-between; align-items: center; background-color: black; }
.footer .photo-action { align-self: center; margin: 0; }
#back { margin-left: auto; flex-direction: row-reverse; }
#back > .photo-action-circle { margin-left: 8px; margin-right: 0; }
#back > .photo-action-underline { left: 0; right: 21px; }
Button { color: #e7e7df; background-color: transparent; border-width: 0; border-radius: 0; padding: 6px; margin: 0; }
Button:hover { color: #D4B854; background-color: rgba(212,184,84,0.07); }
Button:focus { border-color: #D4B854; }
Button:disabled { opacity: 0.35; }
#catalog-details { flex-grow: 1; min-height: 0; margin-top: 12px; }
.catalog-columns { min-height: 0; align-items: flex-start; }
#catalog-primary { width: 73%; flex-shrink: 0; }
.catalog-primary-columns { align-items: flex-start; flex-shrink: 0; }
#catalog-primary .narrow { width: 33.3333%; }
/* Let Description follow the taxonomy sections without a gap imposed by the illustration. */
#catalog-primary .illustration-column { position: absolute; left: 33.3333%; top: 0; width: 66.6667%; padding-left: 8px; translate: 28px 0; }
.catalog-column { padding: 0; }
.catalog-column Label, #description { white-space: normal; }
.narrow { width: 27%; }
.illustration-column { width: 46%; }
.catalog-section { flex-shrink: 0; }
.catalog-ruler { position: absolute; flex-shrink: 0; color: #858585; overflow: visible; }
.catalog-ruler > .ruler-illustration { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.catalog-ruler > Label { position: absolute; font-size: 22px; color: white; white-space: nowrap; margin: 0; padding: 0; }
.catalog-ruler > .ruler-shoulder { left: -40px; top: 50%; translate: -50% -50%; rotate: -90deg; transform-origin: 50% 50%; }
.catalog-ruler > .ruler-length { top: 100%; left: 0; width: 100%; margin-top: 18px; -unity-text-align: upper-center; }
.catalog-ruler > .ruler-mass { left: 10px; bottom: 8px; height: 32px; -unity-text-align: middle-left; }
#distribution-frame { height: 225px; width: 300px; max-width: 100%; align-self: flex-end; background-image: url("/Assets/Arts/Animals/Animal_Catalog/DistributionBison.png"); -unity-background-scale-mode: scale-to-fit; }
#distribution-map, #distribution-unidentified { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#distribution-unidentified { -unity-text-align: middle-center; }
#description-section { width: 110%; padding: 0; }
#conservation-meter { width: 54%; height: 37.8px; flex-shrink: 0; margin-top: 0; margin-bottom: 0; }
#description-section > .catalog-heading { margin-top: 4px; }
#species-photos { align-self: flex-end; flex-shrink: 0; margin-top: 18px; margin-bottom: 12px; }
.action-key-right > .photo-action-circle { margin-left: 8px; margin-right: 0; }
.action-key-right > .photo-action-underline { left: 0; right: 21px; }
#main-catalog { align-self: flex-start; flex-shrink: 0; margin-bottom: 20px; }
#main-catalog .photo-action-caption, .main-catalog-heading-content > Label { color: white; height: 42px; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; translate: 0 -5px; }
#catalog-sidebar { flex-grow: 1; min-height: 0; }
.catalog-sidebar-item, .catalog-sidebar-item:hover, .catalog-sidebar-item:focus { min-height: 0; flex-shrink: 0; margin: 0; padding: 16px; border-width: 1px; border-color: white; background-color: black; background-image: none; color: white; font-size: 30px; white-space: normal; -unity-text-align: middle-left; }
.catalog-sidebar-item:disabled { opacity: 1; }
#catalog-region { display: none; }
#species-page { padding: 12px 56px 28px; font-size: 28px; color: white; }
.catalog-section > Label { margin-left: 0; margin-right: 0; }
#catalog-name { align-self: flex-start; flex-shrink: 0; font-size: 56px; margin: 0 0 12px; padding: 0; translate: 0 10px; white-space: nowrap; }
#catalog-scientific { flex-shrink: 0; align-self: flex-start; font-size: 36px; padding: 2px 6px; margin: 0; border-color: white; overflow: visible; }
.catalog-heading { color: #D4B854; font-size: 36px; margin-top: 10px; margin-bottom: 3px; padding: 0; align-self: flex-start; max-width: 100%; white-space: normal; flex-shrink: 0; }
#physical-heading { margin-top: 0; white-space: nowrap; }
#catalog-scientific { white-space: nowrap; }
.catalog-right-column { align-items: flex-end; }
.catalog-right-column > .catalog-section { width: 100%; margin-bottom: 0; }
.catalog-right-column > .catalog-section > Label { -unity-text-align: upper-right; }
.catalog-right-column > .catalog-section > .catalog-heading { align-self: flex-end; margin-top: 2px; }
#distribution-section { margin-bottom: 8px; }
#distribution-heading { margin-top: 0; }
#species-recognition { flex-grow: 1; min-width: 0; flex-direction: row; align-items: center; margin-right: 30px; translate: 0 -4px; }
#species-recognition > Label { color: #D4B854; font-size: 30px; margin-right: 20px; flex-shrink: 0; }
#recognition { height: 30px; flex-grow: 1; min-width: 0; border-width: 1px; border-color: white; background-color: black; overflow: hidden; translate: 0 4px; }
#recognition-percent { position: absolute; top: 0; bottom: 0; font-size: 24px; color: white; background-color: black; -unity-text-align: middle-center; margin: 0; padding: 0 4px; white-space: nowrap; }
#recognition-caption { position: absolute; top: 0; bottom: 0; font-size: 24px; color: white; -unity-text-align: middle-left; margin: 0; padding: 0; white-space: nowrap; }
.archive-neighbor-navigation { position: absolute; top: 64px; right: 0; height: 72px; min-width: 0; flex-direction: row; margin: 0; padding: 0; border-width: 1px; border-color: white; background-color: black; overflow: hidden; }
#collection-navigation { left: 298px; border-left-width: 0; }
#photo-divider { position: absolute; top: 64px; bottom: 68px; width: 1px; background-color: white; }
#photos-page { padding: 0; }
#sidebar-title { color: white; align-items: flex-start; margin-left: 0; margin-right: 0; }
.species-neighbor { width: auto; min-width: 0; flex-grow: 1; flex-shrink: 1; flex-basis: auto; flex-direction: row; align-items: center; color: #b4b4b4; font-size: 28px; }
.species-neighbor > Label { margin-left: 5px; margin-right: 5px; }
#species-next, #collection-next { justify-content: flex-end; }
.neighbor-key { flex-shrink: 0; }
.neighbor-arrow { font-size: 30px; flex-shrink: 0; }
#previous-species-name, #next-species-name, #previous-collection-name, #next-collection-name { min-width: 0; flex-shrink: 1; white-space: normal; }
.species-neighbor:disabled { opacity: 1; }
.species-neighbor.unavailable > Label { color: black; }
.species-neighbor.unavailable > .neighbor-key { border-color: transparent; }

.heading.archive-heading { border-width: 0; align-self: flex-start; white-space: nowrap; }
.key-action { color: #D4B854; border-width: 1px; border-color: white; font-size: 20px;-unity-font-style: bold; -unity-text-align: middle-center; padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; }
.hint.key-action { justify-content: flex-start; }

#main-catalog-summary { flex-grow: 1; min-height: 0; color: white; }
.main-catalog-heading { height: 42px; flex-shrink: 0; align-items: center; justify-content: center; margin: 0 -16px 20px; }
.main-catalog-heading-content { height: 42px; flex-shrink: 0; }
.main-catalog-heading-content > Label { white-space: nowrap; margin: 0; padding: 0; }
.main-catalog-heading .photo-action-underline { left: 0; }
.catalog-reward-caption { align-items: center; margin-top: 32px; margin-bottom: 16px; flex-shrink: 0; }
.catalog-reward-copy { align-items: flex-start; }
.catalog-reward-lastline { flex-direction: row; align-items: center; }
.catalog-reward-caption Label { white-space: nowrap; font-size: 25px; margin: 0; padding: 0; }
.catalog-reward-lastline > Label { margin-right: 6px; }
.catalog-reward-icon { width: 20px; height: 20px; border-radius: 10px; border-width: 2px; border-color: #D4B854; align-items: center; justify-content: center; flex-shrink: 0; }
.catalog-reward-inner { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: white; background-color: #D4B854; }
.catalog-reward-dot { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 10px; height: 10px; border-radius: 5px; border-width: 3px; border-color: #060706; background-color: #D4B854; }
#catalog-progress-tree { flex-grow: 1; min-height: 0; margin: 0 42px 4px 12px; }
.catalog-tree-tick { position: absolute; left: 0; right: 0; height: 11.1111%; color: white; }
.tree-trunk { position: absolute; left: 85%; top: 0; height: 100%; width: 2px; background-color: white; }
.tree-trunk.filled { background-color: #D4B854; }
.tree-tick-left, .tree-tick-right { position: absolute; top: 0; width: 6%; height: 2px; background-color: white; opacity: 0.45; }
.tree-tick-left { left: 73%; }
.tree-tick-right { left: 91%; }
.reached > .tree-tick-left, .reached > .tree-tick-right { background-color: #D4B854; }
.origin > .tree-tick-left, .milestone > .tree-tick-left { left: 0; width: 100%; opacity: 1; }
.origin > .tree-tick-left { height: 8px; border-left-width: 2px; border-top-width: 2px; border-color: white; background-color: transparent; }
.origin.reached > .tree-tick-left { border-color: #D4B854; background-color: transparent; }
.origin > .tree-tick-right, .milestone > .tree-tick-right { display: none; }
.current > .tree-tick-right { left: 82%; width: 15%; opacity: 1; }
.tree-tick-number { position: absolute; left: 100%; top: -14px; margin: 0 0 0 6px; padding: 0; font-size: 26px; }
.reached > .tree-tick-number { color: #D4B854; }
.tree-reward-frame { position: absolute; left: 6%; top: 0; width: 66%; height: 135%; border-width: 2px; border-color: white; }
.reached > .tree-reward-frame { border-color: #D4B854; }
.tree-reward-icon { position: absolute; left: 100%; top: -9px; margin-left: 24px; }
#catalog-page { padding: 20px; }
#catalog-grid-scroll { flex-grow: 1; min-height: 0; }
#catalog-species-grid { flex-direction: row; flex-wrap: wrap; width: 100%; }
.catalog-card, .catalog-card:hover, .catalog-card:focus { width: 25%; flex-shrink: 0; padding: 14px 16px; margin: 0; align-items: flex-end; background-color: transparent; color: white; border-width: 0; }
.catalog-card-square { border-width: 2px; border-color: white; flex-shrink: 0; align-self: flex-end; }
.catalog-card-preview { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.catalog-card-highlight { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-width: 4px; border-color: #D4B854; display: none; }
.catalog-card-selected .catalog-card-highlight { display: flex; }
.catalog-card-name { font-size: 25px; -unity-text-align: middle-right; white-space: normal; margin: 4px 0 0; padding: 0; }
.catalog-card-status { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 3px; }
.catalog-tier-circle { width: 20px; height: 20px; border-width: 2px; border-color: white; border-radius: 10px; flex-shrink: 0; margin-right: 5px; }
.catalog-card-status > .catalog-reward-icon { margin-right: 5px; }
.catalog-card-percent { font-size: 21px; margin: 0; padding: 0; }
