#earthline-viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #060706; color: white; }
#earthline-shell { position: absolute; left: 18px; right: 18px; top: 16px; bottom: 20px; border-width: 1px; border-color: #9b9c93; }
#earthline-top { height: 76px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; }
#earthline-tab { width: 280px; height: 76px; border-width: 1px; border-color: #9b9c93; border-bottom-width: 7px; border-bottom-color: #D4B854; font-size: 40px; padding-left: 22px; -unity-text-align: middle-left; }
#earthline-connection { flex-direction: row; margin-right: 24px; align-items: center; font-size: 18px; }
#earthline-connection > Label { margin-left: 26px; }
.connection-state { color: #D4B854; }
#earthline-body { flex-direction: row; flex-grow: 1; min-height: 0; border-top-width: 1px; border-top-color: #9b9c93; }
#contacts-sidebar { width: 280px; flex-shrink: 0; padding: 16px 18px; border-right-width: 1px; border-right-color: #9b9c93; }
#contacts-heading { font-size: 21px; align-self: flex-start; -unity-text-align: middle-left; margin-top: 0; margin-bottom: 20px; }
#contact-portrait { width: 242px; height: 242px; border-width: 1px; border-color: white; background-color: #080908; flex-shrink: 0; padding: 24px; }
#contact-name { font-size: 26px; margin-top: 12px; margin-bottom: 2px; }
#contact-profession { font-size: 18px; margin-bottom: 18px; }
#contacts-list { flex-grow: 1; min-height: 0; }
.contact-item, .contact-item:hover { min-height: 76px; flex-shrink: 0; flex-direction: row; padding: 8px; margin-bottom: 10px; align-items: center; border-width: 1px; border-color: white; background-color: transparent; color: white; }
.contact-item.current { border-color: #9b9c93; border-left-width: 2px; border-left-color: #D4B854; }
.contacts-focused .contact-item.current { border-width: 2px; border-color: #D4B854; }
.contact-avatar { width: 48px; height: 48px; border-width: 1px; border-color: white; padding: 5px; flex-shrink: 0; margin-right: 10px; }
.contact-details { flex-grow: 1; min-width: 0; }
.contact-details > Label { margin: 0; padding: 0; white-space: normal; -unity-text-align: middle-left; }
.contact-item-name { font-size: 23px; }
.contact-item-profession { font-size: 16px; margin-top: 6px; }
#earthline-workspace { flex-grow: 1; min-width: 0; }
#earthline-grid { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#conversation-panel { flex-grow: 1; min-height: 0; }
#conversation-header { height: 68px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 28px; border-bottom-width: 1px; border-bottom-color: #9b9c93; }
#conversation-name { font-size: 37px; margin-right: 16px; }
#conversation-profession { font-size: 20px; }
#conversation-date { margin-left: auto; color: #D4B854; font-size: 22px; }
#chat-scroll { flex-grow: 1; min-height: 0; margin: 14px 24px 14px 18px; }
#chat-scroll .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row-reverse; }
#chat-scroll .unity-scroll-view__content-container { flex-grow: 1; width: 100%; }
#chat-scroll .unity-scroller--vertical { width: 7px; min-width: 7px; margin: 0 18px 0 0; background-color: transparent; }
#chat-scroll .unity-scroller__low-button, #chat-scroll .unity-scroller__high-button { display: none; }
#chat-scroll .unity-base-slider__tracker { background-color: transparent; border-width: 0; }
#chat-scroll .unity-base-slider__dragger { background-color: #92938d; border-width: 0; border-radius: 3px; width: 6px; min-width: 6px; }
#chat-scroll.chat-focused .unity-base-slider__dragger { background-color: #D4B854; }
#chat-messages { flex-grow: 1; padding: 8px 10px; }
.message { margin-bottom: 26px; flex-shrink: 0; }
.message-header { flex-direction: row; margin-bottom: 7px; font-size: 21px; }
.message-header > Label { margin: 0 14px 0 0; padding: 0; }
.message-body { border-left-width: 2px; border-left-color: white; padding: 8px 14px; white-space: normal; font-size: 25px; }
.message.player .message-header { justify-content: flex-end; }
.message.player .message-body { border-left-color: #D4B854; }
.message.player { align-items: flex-end; }
.message-empty { font-size: 23px; color: #9b9c93; margin: 32px; white-space: normal; }
.message-photos { max-width: 100%; padding: 12px 12px 8px; background-color: #060706; }
.message-photo-grid { flex-direction: row; flex-wrap: wrap; }
.message-photo { margin: 3px; flex-shrink: 0; }
.message-photo-count { align-self: flex-end; margin-top: 6px; margin-right: 6px; font-size: 18px; }
.photo-corner { position: absolute; width: 58px; height: 58px; border-color: #D4B854; }
.photo-corner.top { left: 0; top: 0; border-left-width: 3px; border-top-width: 3px; }
.photo-corner.bottom { right: 0; bottom: 0; border-right-width: 3px; border-bottom-width: 3px; }
#reply-panel { height: 240px; flex-shrink: 0; border-top-width: 1px; border-top-color: #9b9c93; background-color: #060706; flex-direction: row; }
#reply-options { width: 70%; padding: 14px 26px; }
.reply-heading { color: #D4B854; font-size: 23px; margin-bottom: 10px; }
.reply-option, .reply-option:hover { color: white; font-size: 24px; white-space: normal; flex-grow: 1; -unity-text-align: middle-left; padding: 8px 10px; border-width: 0; background-color: transparent; }
.reply-option.reply-selected, .reply-option.reply-selected:hover { border-width: 1px; border-color: #D4B854; color: white; }
.contact-item.current, .reply-option.reply-selected, .reply-option.reply-selected:hover { background-color: rgba(212,184,84,0.06); }
#share-area { width: 30%; align-items: center; justify-content: center; }
#reply-divider { position: absolute; left: 0; top: 10%; bottom: 10%; width: 1px; background-color: #9b9c93; }
.earthline-action, .earthline-action:hover { flex-direction: row; align-items: center; justify-content: center; font-size: 23px; color: white; border-width: 0; background-color: transparent; padding: 5px; flex-shrink: 0; }
.earthline-key { width: 30px; height: 30px; border-radius: 15px; border-width: 1px; border-color: white; color: #D4B854; -unity-text-align: middle-center; padding: 0; margin-right: 10px; flex-shrink: 0; font-size: 23px; }
.share-caption { border-bottom-width: 1px; border-bottom-color: white; }
.earthline-action.action-frame, .earthline-action.action-frame:hover { border-width: 1px; border-color: white; padding: 6px 12px; }
#photo-picker .earthline-action > Label { margin: 0; }
#photo-picker .earthline-action > .earthline-key { margin-right: 4px; }
#photo-picker { position: absolute; left: 3%; right: 3%; top: 20px; bottom: 20px; border-width: 1px; border-color: white; background-color: #060706; padding: 18px 22px; }
#picker-header { height: 60px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; }
#picker-title { font-size: 34px; }
#picker-scroll { flex-grow: 1; min-height: 0; margin-top: 10px; }
#picker-tiles { flex-direction: row; flex-wrap: wrap; }
#picker-scroll .unity-scroll-view__content-container { width: 100%; }
.picker-tile, .picker-tile:hover { width: 24%; margin-right: 1%; margin-bottom: 0; padding: 5px; border-width: 1px; border-color: white; color: white; background-color: #060706; flex-shrink: 0; align-items: flex-start; }
.picker-tile.highlighted { border-width: 2px; border-color: #D4B854; }
.picker-tile.chosen { border-width: 2px; border-color: #D4B854; }
.picker-tile Label { color: white; white-space: normal; margin: 0; padding: 0; }
.picker-picture { align-self: center; flex-shrink: 0; }
.picker-image { width: 100%; height: 100%; }
.picker-number { position: absolute; left: 0; bottom: 0; border-width: 1px; border-color: white; background-color: black; font-size: 16px; padding: 0 3px; }
.picker-name { font-size: 23px; margin-top: 5px; }
.picker-region { font-size: 17px; }
#picker-empty { position: absolute; left: 30px; right: 30px; top: 45%; font-size: 25px; white-space: normal; -unity-text-align: middle-center; }
#picker-footer { flex-shrink: 0; height: 66px; flex-direction: row; align-items: center; }
#picker-count { margin-right: auto; font-size: 23px; }
#picker-send { margin-left: 16px; }
