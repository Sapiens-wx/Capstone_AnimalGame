<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Map.uss" />
    <ui:VisualElement name="world-map">
      <ui:Image name="map-opening-image" picking-mode="Ignore" />
        <ui:VisualElement name="map-content" picking-mode="Ignore">
          <ui:VisualElement name="map-view-area" class="map-frame-region" picking-mode="Ignore">
            <ui:VisualElement name="map-viewport" picking-mode="Ignore">
              <ui:Image name="map-image" picking-mode="Ignore" />
              <ui:VisualElement name="map-coordinate-mask" picking-mode="Ignore" />
              <AnimalGame.RobotMap.PhotoResultGridElement name="map-grid" offset="0,12" grid-length="56" width="1" />
              <ui:VisualElement name="map-unknown-signal" picking-mode="Ignore">
                <ui:Label name="map-unknown-signal-mark" text="?" picking-mode="Ignore" />
                <ui:Label name="map-unknown-signal-label" text="UNKNOWN SIGNAL SOURCE" picking-mode="Ignore" />
              </ui:VisualElement>
              <ui:Label name="map-coordinate-text" picking-mode="Ignore" />
              <ui:Label name="map-location-name" picking-mode="Ignore" />
              <ui:VisualElement name="pin-0" class="map-circle" picking-mode="Ignore" />
              <ui:VisualElement name="pin-1" class="map-circle" picking-mode="Ignore" />
              <ui:VisualElement name="pin-2" class="map-circle" picking-mode="Ignore" />
              <ui:VisualElement name="map-cursor" picking-mode="Ignore" />
              <ui:VisualElement name="map-north" picking-mode="Ignore">
                <ui:Label name="map-north-label" text="N" picking-mode="Ignore" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="map-data-notice-layer" picking-mode="Ignore">
              <ui:Label name="map-data-notice" text="MISSING MAP DATA" picking-mode="Ignore" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      <ui:VisualElement name="map-frame" class="map-frame-region" picking-mode="Ignore">
       <ui:VisualElement name="map-pin-selector" picking-mode="Ignore">
            <ui:Label name="map-pin-previous-key" text="LB" class="map-pin-cycle-key" picking-mode="Ignore" />
            <ui:VisualElement name="map-pin-options" picking-mode="Ignore">
                <ui:VisualElement name="map-pin-choice-0" class="map-pin-choice" picking-mode="Ignore" />
                <ui:VisualElement name="map-pin-choice-1" class="map-pin-choice" picking-mode="Ignore" />
                <ui:VisualElement name="map-pin-choice-2" class="map-pin-choice" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="map-pin-next-key" text="RB" class="map-pin-cycle-key" picking-mode="Ignore" />
       </ui:VisualElement>
      </ui:VisualElement>
        <ui:VisualElement name="map-controls" picking-mode="Ignore">
            <ui:VisualElement class="map-action">
                <ui:VisualElement class="map-action-underline" />
                <ui:Label name="map-move-key" text="LS" class="map-action-key" />
                <ui:Label text="Move" class="map-action-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="map-action">
                <ui:VisualElement class="map-action-underline" />
                <ui:Label name="map-zoom-key" text="RS" class="map-action-key" />
                <ui:Label text="Zoom" class="map-action-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="map-action">
                <ui:VisualElement class="map-action-underline" />
                <ui:Label name="map-pin-key" text="A" class="map-action-key" />
                <ui:Label text="Place / Remove Pin" class="map-action-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="map-action">
                <ui:VisualElement class="map-action-underline" />
                <ui:Label name="map-center-key" text="Y" class="map-action-key" />
                <ui:Label text="Center on Player" class="map-action-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="map-action">
                <ui:VisualElement class="map-action-underline" />
                <ui:Label name="map-close-key" text="B" class="map-action-key" />
                <ui:Label name="map-close-caption" text="Close" class="map-action-caption" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
