#world-map {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
    background-color: black;
    overflow: hidden;
}
#map-image {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
#map-frame {
    position: absolute;
    left: 2%; right: 2%; top: 3%; bottom: 7%;
    border-width: 1px;
    border-color: white;
    overflow: hidden;
}
#map-viewport {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
}
#map-data-notice {
    display: none;
    position: absolute;
    top: 76%; left: 54%;
    translate: -50% -50%;
    margin: 0;
    padding: 8px 16px;
    border-left-width: 2px;
    border-left-color: #D4B854;
    background-color: rgba(0, 0, 0, 0.9);
    color: #D4B854;
    font-size: 22px;
    -unity-font-definition: resource('UI/Font/Orbitron-Medium');
    -unity-text-align: middle-center;
    white-space: nowrap;
}
#map-pin-selector {
    position: absolute;
    left: 50%; bottom: 0;
    translate: -50% 0;
    transform-origin: 50% 100%;
    scale: 0.8 0.8;
    width: 360px; height: 66px;
    flex-direction: row;
    align-items: flex-end;
    -unity-font-definition: resource('UI/Photo/GeosansLightStatic');
}
#map-pin-options {
    width: 256px; height: 66px;
    flex-direction: row;
    background-color: black;
    border-color: white;
    border-width: 1px;
    flex-shrink: 0;
}
.map-pin-choice { flex-grow: 1; flex-basis: 0; height: 64px; }
.map-pin-cycle-key {
    width: 52px; height: 44px;
    margin: 0; padding: 0;
    background-color: black;
    border-color: white;
    border-width: 1px;
    color: #D4B854;
    font-size: 22px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.map-circle {
    position: absolute;
    width: 14px; height: 14px;
}
#map-grid {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
}
#map-unknown-signal {
    position: absolute;
    display: none;
}
#map-unknown-signal-mark {
    position: absolute;
    left: 50%; top: 50%;
    translate: -50% -50%;
    width: 32px; height: 32px;
    margin: 0; padding: 0;
    border-radius: 50%;
    background-color: black;
    color: #D4B854;
    font-size: 24px;
    -unity-font-definition: resource('UI/Font/Orbitron-Bold');
    -unity-text-align: middle-center;
}
#map-unknown-signal-label {
    position: absolute;
    left: 50%; top: 50%;
    translate: -50% 0;
    margin: 26px 0 0;
    padding: 3px 6px;
    background-color: rgba(0, 0, 0, 0.86);
    color: #D4B854;
    font-size: 16px;
    -unity-font-definition: resource('UI/Font/Orbitron-Medium');
    white-space: nowrap;
}
#map-cursor {
    position: absolute;
}
#map-north {
    position: absolute;
    left: 8px; top: -14px;
    width: 120px; height: 180px;
}
#map-north-label {
    position: absolute;
    left: 0; top: 33.6px; right: 0;
    height: 36px;
    margin: 0; padding: 0;
    color: white;
    font-size: 24px;
    -unity-font-definition: resource('UI/Photo/GeosansLightStatic');
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}
#map-coordinate-mask, #map-coordinate-text {
    position: absolute;
    display: none;
}
#map-coordinate-mask { background-color: black; }
#map-coordinate-text {
    margin: 0;
    padding: 4px 8px;
    color: #e7e7df;
    font-size: 22px;
    -unity-font-definition: resource('UI/Photo/GeosansLightStatic');
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}
#map-controls {
    position: absolute;
    top: 93%; bottom: 0; left: 2%; right: 2%;
    color: #e7e7df;
    font-size: 24px;
    -unity-font-definition: resource('UI/Photo/GeosansLightStatic');
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: transparent;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.map-action {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 14px;
    margin-right: 14px;
    padding-right: 14px;
}
.map-action-key {
    width: 36px; height: 36px;
    margin: 0 8px 0 0;
    padding: 0;
    border-width: 4px;
    border-color: #D4B854;
    border-radius: 50%;
    color: white;
    background-color: black;
    font-size: 20px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.map-action-caption {
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: #e7e7df;
}
.map-action-underline {
    position: absolute;
    left: 18px; right: 0; bottom: 0;
    height: 1px;
    background-color: white;
}
.map-keyboard .map-action-key {
    width: auto;
    min-width: 36px;
    padding-left: 8px; padding-right: 8px;
    border-width: 1px;
    border-color: white;
    border-radius: 0;
    font-size: 16px;
}
