%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00c8407e215b479fb5a26622663cc8a2, type: 3}
  m_Name: TutorialText
  m_EditorClassIdentifier: 
  Panel:
    Header: TUTORIAL
    CurrentLesson: CURRENT LESSON
    CurrentAction: CURRENT ACTION
    CollapseHint: "Tap D-pad \u2190 / \u2192  Hide"
    ExpandHint: Show
    ExpandArrows: "\u2190 \u2192"
    GuideLabel: 'G

      U

      I

      D

      E'
    CollapseTooltip: Tap D-pad Left / Right to hide
    ExpandTooltip: Tap D-pad Left / Right to show
  Driving:
    Title: Driving Practice
    TurnLeft:
      ControlGlyph: L
      Action: Turn left
      Message: 'Push the left stick left.

        Turn on the spot or steer

        while
        driving. Both count.'
      Detail: "Left {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: Left turn complete
    TurnRight:
      ControlGlyph: L
      Action: Turn right
      Message: 'Push the left stick right.

        Turn on the spot or steer

        while
        driving. Both count.'
      Detail: "Right {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: Right turn complete
    Forward:
      ControlGlyph: '{rt}'
      Action: Drive forward
      Message: Hold the right trigger to drive forward. Release it when you reach
        the target distance.
      Detail: Forward {value:F1} / {target:F1} m
      CompleteFeedback: Forward complete
    Reverse:
      ControlGlyph: '{lt}'
      Action: Reverse
      Message: Center the left stick. Hold the left trigger to reverse, then release
        it at the target distance.
      Detail: Reverse {value:F1} / {target:F1} m
      CompleteFeedback: Reverse complete
    SteerWhileMoving:
      ControlGlyph: '{rt}+L'
      Action: Drive and steer
      Message: Hold the right trigger and push the left stick left or right. Keep
        driving as you turn.
      Detail: "Turn {value:F0}\xB0 / {target:F0}\xB0\nDrive {movingDistance:F1} /
        {movingTarget:F1} m"
      CompleteFeedback: Moving turn complete
    Stop:
      ControlGlyph: "\xB7"
      Action: Release inputs
      Message: Release both triggers and center the left stick. Let the robot come
        to a complete stop.
      Detail: Stopped {value:F1} / {target:F1} s
      CompleteFeedback: Stop complete
    Completed:
      ControlGlyph: "\u2713"
      Action: Lesson complete
      Message: Great work! You can now turn, drive forward, reverse, steer while
        moving and stop.
      Detail: Keep practicing freely.
      CompleteFeedback: 
    WaitingStatus: Waiting
    BlockedStatus: Return to driving mode
    CompleteStatus: Lesson complete
  Terrain:
    Title: Terrain & Slopes
    ReachSurvey:
      ControlGlyph: '{rt}+L'
      Action: Follow target
      Message: Follow the gold triangle to the practice area. Distant goals are marked
        along the circular rim.
      Detail: "Destination {distance:F1} m\n{rt} drive \xB7 L steer"
      CompleteFeedback: 
    ScanTerrain:
      ControlGlyph: "{lb}\xD72"
      Action: Scan terrain
      Message: Stop here. Quickly press and release the left bumper twice to scan
        the terrain around you.
      Detail: 'Two short taps

        Release between taps'
      CompleteFeedback: 
    ReadSigns:
      ControlGlyph: "+/\xD7"
      Action: Read signs
      Message: '+ marks a safe approach.

        X warns of danger.

        Signs
        change with your

        position and approach.'
      Detail: "+ Passable   \xD7 Unsafe\nReading {reading:F1} / {readingTarget:F0}
        s"
      CompleteFeedback: 
    FollowRoute:
      ControlGlyph: '{rt}+L'
      Action: Climb the slope
      Message: 'Follow the marker uphill.

        Steeper slopes slow you

        and
        can make you slip.

        Scan again as you move.'
      Detail: "Ground slope {slope:F0}\xB0\nDestination {distance:F1} m"
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Lesson complete
      Message: 'Scan terrain to find a

        safer approach. Choose

        gentle
        slopes and scan

        again as you move.'
      Detail: 'Destination reached

        Keep exploring freely.'
      CompleteFeedback: 
    FollowMarkerStatus: Follow the gold marker
    WaitingScanStatus: Waiting for terrain scan
    WaitingMarkersStatus: Waiting for scan markers
    StopToReadStatus: Stop to read the signs
    ObserveStatus: Observe the scan signs
    BlockedStatus: Return to driving mode
    CompleteStatus: Lesson complete
  Balance:
    Title: Balance
    ReadIndicator:
      ControlGlyph: "\xB7"
      Action: Read the dot
      Message: "The dot shows your\nbalance point.\nThe ring marks your\nsupport area."
      Detail: Read {value:F1} / {target:F0} s
      CompleteFeedback:
    AdjustWeight:
      ControlGlyph: R
      Action: Shift weight
      Message: "Move the right stick.\nWatch the dot move\nas you shift weight."
      Detail: Move the balance point.
      CompleteFeedback:
    ReadRisk:
      ControlGlyph: "\xB7"
      Action: Support ring
      Message: "Keep the point inside\nthe support ring.\nIf it moves outside,\nthe robot will tip."
      Detail: Read {value:F1} / {target:F0} s
      CompleteFeedback:
    Completed:
      ControlGlyph: "\u2713"
      Action: Ready
      Message: "Balance ready.\nUse the right stick to\nadjust your balance."
      Detail: Keep the point inside.
      CompleteFeedback:
    WaitingStatus: Waiting
    ReadingStatus: Read guide
    BlockedStatus: Resume lesson
    NeedStowStatus: Retract arms first
    NeutralStatus: Center right stick
    StopStatus: Stop to continue
    CompleteStatus: Lesson complete
    ToggleHint: "R \xB7 Balance"
    NeedStowMessage: "Press L3 to retract\nyour arms and return\nto driving controls."
    NeutralMessage: "Center the right stick.\nThen move it again to\nshift your balance."
    StopMessage: "Release the triggers.\nStop to continue\nthis balance lesson."
  Arms:
    Title: Mechanical Arms
    Deploy:
      ControlGlyph: L3
      Action: Deploy arms
      Message: 'Click the left stick (L3)

        to deploy both arms.

        L3
        also retracts them.'
      Detail: Press once, then release.
      CompleteFeedback:
    Extend:
      ControlGlyph: "L \u2191"
      Action: Extend reach
      Message: 'Push the left stick up.

        Move the empty hands

        farther
        from the body.'
      Detail: Out {value:F0} / {target:F0} cm
      CompleteFeedback:
    RetractReach:
      ControlGlyph: "L \u2193"
      Action: Shorten reach
      Message: 'Push the left stick down.

        Bring the empty hands

        closer
        to the body.'
      Detail: In {value:F0} / {target:F0} cm
      CompleteFeedback:
    SwingLeft:
      ControlGlyph: "L \u2190"
      Action: Swing left
      Message: 'Push the left stick left.

        Swing the empty hands

        toward
        the left side.'
      Detail: "Left {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback:
    SwingRight:
      ControlGlyph: "L \u2192"
      Action: Swing right
      Message: 'Push the left stick right.

        Swing the empty hands

        toward
        the right side.'
      Detail: "Right {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback:
    HoldStill:
      ControlGlyph: L
      Action: Hold position
      Message: 'Center the left stick.

        The hands stay where

        you
        leave them.

        Keep them still.'
      Detail: Still {value:F1} / {target:F1} s
      CompleteFeedback:
    Stow:
      ControlGlyph: L3
      Action: Retract arms
      Message: 'Click the left stick (L3)

        to retract both arms.

        This
        restores driving.'
      Detail: Press once, then release.
      CompleteFeedback:
    Completed:
      ControlGlyph: "\u2713"
      Action: Arms complete
      Message: 'Arm controls complete.

        You are ready to scan

        wildlife
        and objects.'
      Detail: Arms safely retracted.
      CompleteFeedback:
    WaitingStatus: Waiting
    BlockedStatus: Return to arm practice
    ReopenStatus: Deploy arms to continue
    EmptyHandsStatus: Put down held items
    CompleteStatus: Lesson complete
    ToggleHint: "L3 \xB7 Deploy / Retract"
    ReopenMessage: 'Press L3 to deploy your

      arms and continue.'
    InitialStowMessage: 'Press L3 to retract your

      arms, then press again

      to
      deploy.'
    InitialStowAction: Retract first
    StowRecoveryMessage: 'Press L3 to deploy your

      arms, then press again

      to
      retract.'
  Discovery:
    Title: Discovery Scan
    ApproachAnimal:
      ControlGlyph: LS
      Action: Follow marker
      Message: "Follow the marker.\nScan again when nearby.\nLook for the woodpecker\non dry ground."
      Detail: Stay on dry ground.
      CompleteFeedback:
    Charge:
      ControlGlyph: '{lb}'
      Action: Charge scan
      Message: 'Hold the left bumper.

        Keep holding to charge

        a
        discovery scan.'
      Detail: Charge {value:F0}%
      CompleteFeedback:
    Release:
      ControlGlyph: '{lb}'
      Action: Release to scan
      Message: 'The scan is ready.

        Release the left bumper

        to send
        the pulse.'
      Detail: Release {lb} to scan
      CompleteFeedback:
    FindAnimal:
      ControlGlyph: "\u2727"
      Action: Find bird
      Message: "A hollow star marks\nwildlife not yet seen.\nFind the woodpecker."
      Detail: "Hollow star \xB7 Unseen"
      CompleteFeedback:
    ConfirmAnimal:
      ControlGlyph: "\u2726"
      Action: See bird
      Message: "Bring the woodpecker\ninside your view.\nIts star becomes solid\nwhen you see it."
      Detail: "Solid star \xB7 Seen"
      CompleteFeedback:
    ReadObject:
      ControlGlyph: ///
      Action: Inspect object
      Message: "Stripes and diamonds\nmark objects you can\ninteract with. Some need\nmore than recycling."
      Detail: "Striped mark \xB7 Interact"
      CompleteFeedback:
    Rescan:
      ControlGlyph: '{lb}'
      Action: Scan again
      Message: 'Marks fade over time.

        Hold the left bumper.

        Release
        at full charge

        to refresh nearby marks.'
      Detail: Scans {value:F0} / {target:F0}
      CompleteFeedback:
    Completed:
      ControlGlyph: "\u2713"
      Action: Scan complete
      Message: 'Scan complete.

        You can now find wildlife

        and useful
        objects.'
      Detail: Keep exploring freely.
      CompleteFeedback:
    WaitingStatus: Waiting
    CancelledStatus: Scan cancelled
    WrongGestureStatus: Hold for discovery scan
    NeedRescanStatus: Scan again to continue
    NeedEmptyHandsStatus: Retract arms to scan
    BlockedStatus: Return to scan practice
    CompleteStatus: Lesson complete
    PreparingStatus: Preparing nearby targets
    ToggleHint: "Hold {lb} \xB7 Charge / Release"
    NeedRescanMessage: 'The scan marks faded.

      Hold the left bumper,

      then
      release when full

      to scan again.'
    NeedStowMessage: 'Press L3 to retract your

      arms before scanning.'
  Photography:
    Title: Photo Practice
    ObserveMovement:
      ControlGlyph: "\u2726"
      Action: Observe bird
      Message: "Keep the woodpecker\ninside your view.\nPrepare to take a photo."
      Detail: Keep the bird in view.
      CompleteFeedback:
    EnterPhoto:
      ControlGlyph: '{photo}'
      Action: Enter photo
      Message: "Press {photo} to enter\nphoto mode and open\nthe camera view."
      Detail: Press once, then release.
      CompleteFeedback:
    FrameSubject:
      ControlGlyph: L
      Action: Frame bird
      Message: "Use the triggers to move.\nSteer with the left stick.\nBring the bird into\nthe camera frame."
      Detail: "{rt} / {lt} move \xB7 L steer"
      CompleteFeedback:
    Capture:
      ControlGlyph: '{rb}'
      Action: Hold to capture
      Message: "Hold the right bumper.\nKeep the bird framed\nuntil the photo is taken."
      Detail: Hold {rb} until captured.
      CompleteFeedback:
    SavePhoto:
      ControlGlyph: '{save}'
      Action: Save photo
      Message: "Save the bird photo.\nPress {save} on the result\nscreen to add it to\nyour album."
      Detail: "{save} \xB7 Save to album"
      CompleteFeedback:
    ExitPhoto:
      ControlGlyph: '{cancel}'
      Action: Resume driving
      Message: "Photo saved.\nPress {cancel} to leave\nphoto mode and return\nto driving."
      Detail: "{cancel} \xB7 Back"
      CompleteFeedback:
    Completed:
      ControlGlyph: "\u2713"
      Action: Photo complete
      Message: "Photo saved.\nYou can now photograph\nwildlife as you explore."
      Detail: Keep exploring freely.
      CompleteFeedback:
    WaitingStatus: Waiting
    BlockedStatus: Return to photo practice
    TargetMissingStatus: Follow the bird marker
    NeedStowStatus: Retract arms first
    NeedRescanStatus: Scan again to find it
    RetryPhotoStatus: Photograph the bird
    SavedStatus: Photo saved to album
    CompleteStatus: Lesson complete
    ToggleHint: "{photo} \xB7 Photo / {cancel} \xB7 Back"
    TargetMissingMessage: "Follow the gold marker.\nLook for the woodpecker\nnearby on dry ground."
    NeedStowMessage: "Press L3 to retract\nyour arms before\nentering photo mode."
    NeedRescanMessage: "The star marker faded.\nHold the left bumper,\nthen release at full\ncharge to find it again."
    RetryPhotoMessage: "The woodpecker was not\nrecorded in that photo.\nBring it into the frame\nand hold {rb} to try again."
