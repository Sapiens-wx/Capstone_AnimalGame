%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00c8407e215b479fb5a26622663cc8a2, type: 3}
  m_Name: TutorialText
  m_EditorClassIdentifier: 
  Panel:
    Header: TUTORIAL
    CurrentLesson: CURRENT LESSON
    CurrentAction: CURRENT ACTION
    CollapseHint: "Tap D-pad \u2190 / \u2192  Hide"
    ExpandHint: Show
    ExpandArrows: "\u2190 \u2192"
    GuideLabel: 'G

      U

      I

      D

      E'
    CollapseTooltip: Tap D-pad Left / Right to hide
    ExpandTooltip: Tap D-pad Left / Right to show
    ContinuePrompt: Press A to continue
    ContinueWaitingPrompt: Complete this step to continue
  Driving:
    Title: Driving Practice
    TurnLeft:
      ControlGlyph: L
      Action: Turn left
      Message: 'Push the left stick left

        to turn left.'
      Detail: "Left {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: Left turn complete
    TurnRight:
      ControlGlyph: L
      Action: Turn right
      Message: 'Push the left stick right

        to turn right.'
      Detail: "Right {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: Right turn complete
    Forward:
      ControlGlyph: '{rt}'
      Action: Drive forward
      Message: 'Hold the right trigger to drive forward. '
      Detail: Forward {value:F1} / {target:F1} m
      CompleteFeedback: Forward complete
    Reverse:
      ControlGlyph: '{lt}'
      Action: Reverse
      Message: Hold the left trigger to reverse.
      Detail: Reverse {value:F1} / {target:F1} m
      CompleteFeedback: Reverse complete
    SteerWhileMoving:
      ControlGlyph: '{rt}+L'
      Action: Drive and steer
      Message: Hold the right trigger and push the left stick left or right. Keep
        driving as you turn.
      Detail: "Turn {value:F0}\xB0 / {target:F0}\xB0\nDrive {movingDistance:F1} /
        {movingTarget:F1} m"
      CompleteFeedback: Moving turn complete
    Completed:
      ControlGlyph: "\u2713"
      Action: Lesson complete
      Message: 'Great work! '
      Detail: Keep practicing freely.
      CompleteFeedback: 
    WaitingStatus: Waiting
    BlockedStatus: Return to driving mode
    CompleteStatus: Lesson complete
    NeedStowStatus: Retract arms first
    NeedStowMessage: 'Press L3 to retract

      your mechanical arms,

      then
      resume driving.'
  Terrain:
    Title: Terrain & Slopes
    ReachSurvey:
      ControlGlyph: 
      Action: Follow target
      Message: 'Follow the yellow triangle to the practice area. '
      Detail: "Destination {distance:F1} m\n{rt} drive \xB7 L steer"
      CompleteFeedback: 
    ScanTerrain:
      ControlGlyph: "{lb}\xD72"
      Action: Scan terrain
      Message: Quickly press and release the left bumper twice to scan the terrain.
      Detail: 'Two short taps

'
      CompleteFeedback: 
    ReadSigns:
      ControlGlyph: 
      Action: Read signs
      Message: '+ marks a passable point.

        X marks an unpassable point.

        Signs
        change in time with your

        current position and direction.'
      Detail: "+ Passable   \xD7 Unpassable\nReading {reading:F1} / {readingTarget:F0}
        s"
      CompleteFeedback: 
    FollowRoute:
      ControlGlyph: 
      Action: Climb the slope
      Message: 'The denser the lines are,

        the steeper the terrain is.

        You
        cannot walk across

        terrains that are too steep.'
      Detail: "Ground slope {slope:F0}\xB0\nDestination {distance:F1} m"
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Lesson complete
      Message: 'Scan terrain to find a

        safer approach. Choose

        gentle
        slopes and scan

        again as you move.'
      Detail: 'Destination reached

        Keep exploring freely.'
      CompleteFeedback: 
    FollowMarkerStatus: Follow the gold marker
    WaitingScanStatus: Waiting for terrain scan
    WaitingMarkersStatus: Waiting for scan markers
    StopToReadStatus: Stop to read the signs
    ObserveStatus: Observe the scan signs
    BlockedStatus: Return to driving mode
    CompleteStatus: Lesson complete
    NeedStowStatus: Retract arms first
    NeedStowMessage: 'Press L3 to retract

      your mechanical arms,

      then
      continue the route.'
  Balance:
    Title: Balance
    ReadIndicator:
      ControlGlyph: 
      Action: 
      Message: "The whitedot connecting you \nis your balance point.\nThe ring around
        marks \nyour balance range."
      Detail: Read {value:F1} / {target:F0} s
      CompleteFeedback: 
    AdjustWeight:
      ControlGlyph: R
      Action: Shift weight
      Message: 'Move the right stick

        to shift weight.'
      Detail: Move the balance point.
      CompleteFeedback: 
    ReadRisk:
      ControlGlyph: 
      Action: Support ring
      Message: 'Keep the point inside

        the balance range.

        If it
        moves outside,

        you will tip.'
      Detail: Read {value:F1} / {target:F0} s
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Ready
      Message: 'Balance ready.

        Use the right stick to

        adjust your
        balance.'
      Detail: Keep the point inside.
      CompleteFeedback: 
    WaitingStatus: Waiting
    ReadingStatus: Read guide
    BlockedStatus: Resume lesson
    NeedStowStatus: Retract arms first
    NeutralStatus: Center right stick
    StopStatus: Stop to continue
    CompleteStatus: Lesson complete
    ToggleHint: "R \xB7 Balance"
    NeedStowMessage: 'Press L3 to retract

      your arms and return

      to driving
      controls.'
    NeutralMessage: 'Center the right stick.

      Then move it again to

      shift
      your balance.'
    StopMessage: 'Release the triggers.

      Stop to continue

      this balance
      lesson.'
  Arms:
    Title: Mechanical Arms
    Deploy:
      ControlGlyph: L3
      Action: Deploy arms
      Message: 'Click the left stick (L3)

        to deploy both arms.

        L3
        also retracts them.'
      Detail: Press once.
      CompleteFeedback: 
    Extend:
      ControlGlyph: "L \u2191"
      Action: Extend reach
      Message: 'Push the left stick up

        to move the hands

        farther
        from the body.'
      Detail: Out {value:F0} / {target:F0} cm
      CompleteFeedback: 
    RetractReach:
      ControlGlyph: "L \u2193"
      Action: Shorten reach
      Message: 'Push the left stick down

        to move the hands

        closer
        to the body.'
      Detail: In {value:F0} / {target:F0} cm
      CompleteFeedback: 
    SwingLeft:
      ControlGlyph: "L \u2190"
      Action: Swing left
      Message: 'Push the left stick left

        to move the hands

        toward
        the left side.'
      Detail: "Left {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: 
    SwingRight:
      ControlGlyph: "L \u2192"
      Action: Swing right
      Message: "Push the left stick right \nto move the hands\ntoward the right side."
      Detail: "Right {value:F0}\xB0 / {target:F0}\xB0"
      CompleteFeedback: 
    Stow:
      ControlGlyph: L3
      Action: Retract arms
      Message: 'Click the left stick (L3)

        to retract both arms.'
      Detail: 
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Arms complete
      Message: 'Arm controls complete.

'
      Detail: Arms safely retracted.
      CompleteFeedback: 
    WaitingStatus: Waiting
    BlockedStatus: Return to arm practice
    ReopenStatus: Deploy arms to continue
    EmptyHandsStatus: Put down held items
    CompleteStatus: Lesson complete
    ToggleHint: "L3 \xB7 Deploy / Retract"
    ReopenMessage: 'Press L3 to deploy your

      arms and continue.'
    InitialStowMessage: 'Press L3 to retract your

      arms, then press again

      to
      deploy.'
    InitialStowAction: Retract first
    StowRecoveryMessage: 'Press L3 to deploy your

      arms, then press again

      to
      retract.'
  Discovery:
    Title: Discovery Scan
    ApproachAnimal:
      ControlGlyph: LS
      Action: Follow target
      Message: Follow the marker.
      Detail: 
      CompleteFeedback: 
    Charge:
      ControlGlyph: '{lb}'
      Action: Charge scan
      Message: 'Hold the left bumper.

        Keep holding to charge

        a
        discovery scan.'
      Detail: Charge {value:F0}%
      CompleteFeedback: 
    Release:
      ControlGlyph: '{lb}'
      Action: Release to scan
      Message: 'Release the left bumper

        to send the pulse.'
      Detail: Release {lb} to scan
      CompleteFeedback: 
    FindAnimal:
      ControlGlyph: "\u2727"
      Action: Follow target
      Message: 'A hollow star marks

        wildlife not yet seen.

        Find
        that wildlife.'
      Detail: "Hollow star \xB7 Unseen"
      CompleteFeedback: 
    ConfirmAnimal:
      ControlGlyph: "\u2726"
      Action: Follow target
      Message: "The hollow star becomes \nsolid when you see it."
      Detail: "Solid star \xB7 Seen"
      CompleteFeedback: 
    Rescan:
      ControlGlyph: '{lb}'
      Action: Charge scan
      Message: 'Hold the left bumper.

        Release at full charge

        to
        locate nearby targets.'
      Detail: Release {lb} to scan
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Scan complete
      Message: 'Scan complete.

        You can now find wildlife

        and useful
        objects.'
      Detail: Keep exploring freely.
      CompleteFeedback: 
    WaitingStatus: Waiting
    CancelledStatus: Scan cancelled
    WrongGestureStatus: Hold for discovery scan
    NeedRescanStatus: Locate the target
    NeedEmptyHandsStatus: Retract arms to scan
    BlockedStatus: Return to scan practice
    CompleteStatus: Lesson complete
    PreparingStatus: Preparing nearby targets
    ToggleHint: "Hold {lb} \xB7 Charge / Release"
    NeedRescanMessage: 'Hold the left bumper.

      Release at full charge

      to
      locate the target.'
    NeedStowMessage: 'Press L3 to retract your

      arms before scanning.'
  Recycling:
    Title: Waste Recycling
    ReachWaste:
      ControlGlyph: L
      Action: Find the waste
      Message: 'The marked waste

        can be recycled.

        Move closer to

        reach
        it with your arms.'
      Detail: Waste {distance:F1} m
      CompleteFeedback: 
    DeployArms:
      ControlGlyph: L3
      Action: Deploy arms
      Message: 'Press L3 to deploy

        your mechanical arms.

        Use the
        left stick

        to move the hands.'
      Detail: Press once, then release.
      CompleteFeedback: 
    RecycleWaste:
      ControlGlyph: '{confirm}'
      Action: Grip and recycle
      Message: 'Move a hand onto waste.

        Hold {confirm} to grip it.

        Keep
        holding, then pull

        the left stick back.'
      Detail: "Hold {confirm} \xB7 Keep grip"
      CompleteFeedback: 
    ReachLargeWaste:
      ControlGlyph: L
      Action: Find large waste
      Message: 'Follow the marker.

        This large pile needs pulling.'
      Detail: Approach {distance:F1} m
      CompleteFeedback: 
    RecycleLargeWaste:
      ControlGlyph: '{lt}'
      Action: Pull and recycle
      Message: 'Move both hands to

        the large pile. Hold A,

        then
        hold {lt} to pull

        it apart.'
      Detail: "A \xB7 Grip / {lt} \xB7 Reverse"
      CompleteFeedback: 
    LargePullMessage: 'Keep holding A.

      Hold {lt} to reverse.

      Keep pulling
      until

      the pile breaks apart.'
    LargePullAction: Pull apart
    LargePullDetail: Pull {pull:F0}%
    LargePullStatus: Hold A + {lt}
    LargeToggleHint: "A \xB7 Grip / {lt} \xB7 Pull"
    FragmentAction: Recycle fragment
    FragmentHoldingMessage: 'A piece is in your hands.

      Release {lt}. Keep
      A held.

      Pull the left stick back

      to the yellow inlet.'
    FragmentDroppedMessage: 'Hold A to grip the piece.

      Pull the left stick
      back.

      Release A at the yellow

      inlet to recycle it.'
    LargeRecycledMessage: 'Large waste cleared.

      Materials recovered.

      You
      can recycle the

      remaining pieces too.'
    LargeReopenMessage: 'Click L3 to deploy.

      Move both hands to

      the
      large pile and hold A.

      Hold {lt} to pull it apart.'
    StowArms:
      ControlGlyph: L3
      Action: Retract arms
      Message: 'Waste recycled.

        Press L3 to retract

        your mechanical
        arms

        and resume driving.'
      Detail: Press once, then release.
      CompleteFeedback: 
    OpenInventory:
      ControlGlyph: '{inventoryRight}'
      Action: Open inventory
      Message: 'Recovered materials

        are stored in inventory.

        Hold
        D-pad {inventoryRight}

        to open it.'
      Detail: Hold {inventoryRight} to open.
      CompleteFeedback: 
    ViewMaterials:
      ControlGlyph: '{inventoryLeft}'
      Action: Close inventory
      Message: 'Recovered raw materials

        are stored here.

        Processing
        sites turn them

        into useful materials.'
      Detail: "Hold {inventoryLeft} / Tap {cancel} \xB7 Close"
      CompleteFeedback: 
    OpenInventoryHint: "Hold {inventoryRight} \xB7 Open inventory"
    InventoryToggleHint: "Hold {inventoryLeft} / Tap {cancel} \xB7 Close"
    MaterialsDetail: '{materials}'
    NoMaterialsDetail: No materials in storage.
    Completed:
      ControlGlyph: "\u2713"
      Action: Recycling ready
      Message: 'Recycling complete.

        Materials recovered.

        Next,
        upgrade your camera

        at the large machine.'
      Detail: "Next \xB7 Camera upgrade"
      CompleteFeedback: 
    WaitingStatus: Follow the guide
    BlockedStatus: Resume recycling
    StopStatus: Stop beside the waste
    PreparingStatus: Preparing waste target
    HoldingStatus: Keep holding {confirm}
    PullStatus: Pull the left stick back
    ReadyStatus: Release {confirm} to recycle
    ProcessingStatus: Processing waste
    RecycledStatus: Waste recycled
    DroppedStatus: Pick up the waste again
    CompleteStatus: Lesson complete
    TargetMissingStatus: Restoring waste target
    ToggleHint: "L3 \xB7 Arms / {confirm} \xB7 Grip"
    HoldingMessage: 'Keep holding {confirm}.

      Pull the left stick back.

      Adjust
      left or right

      to line up the inlet.'
    ReadyMessage: 'Waste is at the inlet.

      Release {confirm}

      to begin
      recycling.'
    ProcessingMessage: 'The waste is processing.

      Wait until recycling

      is
      complete.'
    RecycledMessage: 'Waste recycled.

      Materials recovered.

      Release
      {confirm} before

      continuing the lesson.'
    DroppedMessage: 'The waste was dropped.

      Move a hand to it

      and hold
      {confirm}

      to pick it up again.'
    TargetMissingMessage: 'The teaching waste

      is being restored.

      Follow
      its marker

      when it returns.'
    ReopenMessage: 'Press L3 to deploy

      your arms again.

      Move a hand
      to the waste

      and hold {confirm} to grip.'
    StowRecoveryMessage: 'Press L3 to deploy,

      then press L3 again

      to
      retract your arms.'
  Photography:
    Title: Photo Practice
    ObserveMovement:
      ControlGlyph: "\u2726"
      Action: Observe
      Message: 'Watch the wildlife and

        prepare to take a photo.'
      Detail: Keep the wildlife in view.
      CompleteFeedback: 
    EnterPhoto:
      ControlGlyph: '{photo}'
      Action: Enter photo
      Message: 'Press {photo} to enter

        photo mode and open

        the
        camera view.'
      Detail: Press once, then release.
      CompleteFeedback: 
    FrameSubject:
      ControlGlyph: L
      Action: Frame bird
      Message: 'Use the triggers to move.

        Steer with the left stick.

        Bring
        the bird into

        the camera frame.'
      Detail: "{rt} / {lt} move \xB7 L steer"
      CompleteFeedback: 
    Capture:
      ControlGlyph: '{rb}'
      Action: Hold to capture
      Message: 'Hold the right bumper.

        Keep the bird framed

        until
        the photo is taken.'
      Detail: Hold {rb} until captured.
      CompleteFeedback: 
    SavePhoto:
      ControlGlyph: '{save}'
      Action: Save photo
      Message: 'Save the bird photo.

        Press {save} on the result

        screen
        to add it to

        your album.'
      Detail: "{save} \xB7 Save to album"
      CompleteFeedback: 
    ExitPhoto:
      ControlGlyph: '{cancel}'
      Action: Resume driving
      Message: 'Photo saved.

        Press {cancel} to leave

        photo mode
        and return

        to driving.'
      Detail: "{cancel} \xB7 Back"
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Photo complete
      Message: 'Photo saved.

        You can now photograph

        wildlife as
        you explore.'
      Detail: "Next \xB7 Waste recycling"
      CompleteFeedback: 
    WaitingStatus: Waiting
    BlockedStatus: Return to photo practice
    TargetMissingStatus: Follow the bird marker
    NeedStowStatus: Retract arms first
    NeedRescanStatus: Locate the bird
    RetryPhotoStatus: Photograph the bird
    SavedStatus: Photo saved to album
    CompleteStatus: Lesson complete
    ToggleHint: "{photo} \xB7 Photo / {cancel} \xB7 Back"
    CapturedStatus: Woodpecker photographed
    TargetMissingMessage: 'Follow the gold marker.

      Look for the woodpecker

      on
      the tree trunk.'
    NeedStowMessage: 'Press L3 to retract

      your arms before

      entering
      photo mode.'
    NeedRescanMessage: 'Hold the left bumper.

      Release at full charge

      to
      locate the bird.'
    CapturedMessage: 'Woodpecker photographed.

      The bird is flying away.

      Continue
      exploring.'
    RecoverySaveMessage: 'Your captured photo

      is ready. Press {save}

      to
      save it to your album.'
    RetryPhotoMessage: 'The wildlife was not

      recorded in that photo.

      Bring
      it into the frame

      and hold {rb} to try again.'
  Refit:
    Title: Camera Upgrade
    ReachMachine:
      ControlGlyph: L
      Action: Find the machine
      Message: 'Your camera is damaged.

        Follow the marker to

        the
        large machine.

        Approach its entrance.'
      Detail: Entrance {distance:F1} m
      CompleteFeedback: 
    EnterMachine:
      ControlGlyph: '{rt}'
      Action: Drive inside
      Message: 'Drive through the

        entrance to enter

        the large machine.'
      Detail: Keep the doorway clear.
      CompleteFeedback: 
    ReachWorkbench:
      ControlGlyph: L
      Action: Find workbench
      Message: 'Follow the marker to

        the assembly station.

        Move
        beside the station

        to use it.'
      Detail: Station {distance:F1} m
      CompleteFeedback: 
    OpenWorkbench:
      ControlGlyph: '{confirm}'
      Action: Use workbench
      Message: 'Open the station with {confirm}.

        Choose CAMERA, then

        select
        Zoom Lens 300.

        Press {confirm} to equip it.'
      Detail: "{cancel} \xB7 Close after equipping"
      CompleteFeedback: 
    RefitIntroduction:
      ControlGlyph: '{confirm}'
      Action: Read refit guide
      Message: 'Use this station to

        change equipment.

        Install a
        better camera

        for clearer photographs.'
      Detail: Choose a new lens.
      CompleteFeedback: 
    EquipLens:
      ControlGlyph: '{confirm}'
      Action: Install better lens
      Message: 'At the assembly station,

        choose CAMERA and

        install
        Zoom Lens 300.

        Close the station with {cancel}.'
      Detail: "{lb}/{rb} \xB7 CAMERA\n\u2190 / \u2192 \xB7 Lens \xB7 {confirm} equip"
      CompleteFeedback: 
    CloseRefit:
      ControlGlyph: '{cancel}'
      Action: Return to driving
      Message: 'New lens installed.

        Press {cancel} to close

        the
        assembly station

        and resume driving.'
      Detail: "{cancel} \xB7 Back"
      CompleteFeedback: 
    NewLensControls:
      ControlGlyph: R
      Action: Move camera frame
      Message: "Press {photo} to open the camera.\nMove the right stick\nto adjust the frame.\nTry it with Zoom Lens 300."
      Detail: "{photo} \xB7 Open camera\nR \xB7 Move frame"
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Camera upgraded
      Message: 'Camera upgraded.

        Use your new lens

        to photograph
        wildlife

        as you explore.'
      Detail: New lens ready.
      CompleteFeedback: 
    WaitingStatus: Follow the guide
    PreparingStatus: Finding assembly station
    BlockedStatus: Return to refit practice
    StopStatus: Stop beside the target
    NeedStowStatus: Retract arms first
    InstalledStatus: New lens installed
    CompleteStatus: Lesson complete
    ToggleHint: "{rt}/{lt} \xB7 Drive / L \xB7 Steer"
    NewLensToggleHint: "{photo} \xB7 Camera / R \xB7 Frame"
    MenuTitle: CAMERA UPGRADE
    MenuIntroductionMessage: 'Use this station to change your equipment.

      Install
      a better camera for clearer photographs.'
    MenuEquipMessage: "Switch to CAMERA with {lb} / {rb}.\nChoose {lens} with D-pad
      \u2190 / \u2192."
    MenuInstalledMessage: 'Your new lens is installed.

      Release {confirm},
      then press it again to continue.'
    MenuCloseMessage: 'The new lens is ready.

      Press {cancel} to close the
      assembly station.'
    MenuSlotHint: "{lb} / {rb} \xB7 Select CAMERA"
    MenuModuleHint: "D-pad \u2190 / \u2192 \xB7 Select lens"
    MenuEquipHint: "{confirm} \xB7 Equip"
    MenuBackHint: "{cancel} \xB7 Back"
    MenuInspectHint: "{photo} \xB7 Inspect"
    InstalledMessage: 'Zoom Lens 300 installed.

      Close the station with {cancel}

      to
      resume the tutorial.'
    NeedStowMessage: 'Press L3 to retract

      your arms before using

      the
      assembly station.'
  TipOver:
    Title: Tip-over Recovery
    ContextLabel: CONTEXT TUTORIAL
    RollingMessage: 'You have tipped over.

      Wait for it to

      stop rolling.'
    RollingAction: Wait for the robot
    RollingDetail: Recovery starts when still.
    Explanation:
      ControlGlyph: '{confirm}'
      Action: Learn to recover
      Message: 'Your balance point left

        the support area.

        Use your
        arms to help

        the robot stand upright.'
      Detail: Resume after recovery.
      CompleteFeedback: 
    DeployArms:
      ControlGlyph: L3
      Action: Deploy arms
      Message: 'Press L3 to deploy

        your mechanical arms.

        They can
        support

        the fallen robot.'
      Detail: Press once, then release.
      CompleteFeedback: 
    Recover:
      ControlGlyph: L+R
      Action: Brace and recover
      Message: "~{cadence:F0} pushes per second.\nKeep L held to brace.\nPush R opposite the fall,\ntoward the robot center.\nRecenter R each time."
      Detail: Move yellow point inward.
      CompleteFeedback: 
    Completed:
      ControlGlyph: "\u2713"
      Action: Robot stabilized
      Message: 'The robot is upright

        and stable again.

        Continue
        your

        previous tutorial.'
      Detail: Your progress is retained.
      CompleteFeedback: 
    SupportMessage: "Push L toward the bar\non the fallen side.\nKeep pushing so the arms\nbrace against it."
    EffortMessage: "~{cadence:F0} pushes per second.\nKeep L held to brace.\nPush R opposite the fall,\ntoward the robot center.\nRecenter R each time."
    RightingMessage: 'The robot is lifting.

      Get ready to adjust

      your
      balance point

      when it lands.'
    StabilizeMessage: 'Use the right stick

      to keep the balance point

      inside
      the support area

      until the robot is stable.'
    ArmLostMessage: "Arm support was lost.\nPush L toward the bar\non the fallen side.\nKeep it held to brace."
    CadenceLostMessage: "~{cadence:F0} pushes per second.\nKeep L held to brace.\nPush R opposite the fall,\ntoward the robot center.\nRecenter R each time."
    DirectionLostMessage: "~{cadence:F0} pushes per second.\nKeep L held to brace.\nPush R from yellow point\ntoward robot center.\nRecenter R each time."
    ReminderMessage: "~{cadence:F0} pushes per second.\nL3 deploys your arms.\nHold L toward support.\nPush R opposite the fall.\nRecenter R each time."
    WaitingStatus: Follow the recovery guide
    SupportStatus: Brace on fallen side
    EffortStatus: Push balance inward
    RightingStatus: Righting the robot
    StabilizeStatus: Keep the balance point inside
    CompleteStatus: Ready to resume
    RetryStatus: Try the recovery again
    ToggleHint: "L \xB7 Brace / R \xB7 Push, recenter"
    ResumePrompt: "A \xB7 Resume tutorial"
    InertiaTitle: Landing Recoil
    InertiaMessage: 'Standing up creates

      recoil toward {inertia}.

      Push
      the right stick {counter}

      to stop another fall.'
    InertiaAction: Counter the recoil
    InertiaDetail: "R {counter} \xB7 Oppose the force\nKeep the dot inside."
    InertiaStatus: "Slow motion \xB7 5% speed"
    InertiaContinuePrompt: "A \xB7 Continue"
