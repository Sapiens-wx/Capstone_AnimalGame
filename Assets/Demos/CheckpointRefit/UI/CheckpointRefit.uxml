<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:refit="AnimalGame.Demos.CheckpointRefit" xmlns:hud="AnimalGame.MainUI" xmlns:archive="AnimalGame.Animals.UI" editor-extension-mode="False">
    <Style src="CheckpointRefit.uss" />
    <ui:VisualElement name="refit-host" class="refit-host" picking-mode="Ignore">
    <ui:Label name="refit-interaction-prompt" class="refit-interaction-prompt" picking-mode="Ignore" />
    <ui:VisualElement name="refit-screen" class="refit-screen">
        <ui:VisualElement name="refit-stage" class="refit-stage">
            <ui:VisualElement class="maintenance-frame" picking-mode="Ignore" />
            <ui:VisualElement name="maintenance-tabs" class="maintenance-tabs" picking-mode="Ignore">
                <ui:Button name="repair-tab" class="maintenance-tab">
                    <ui:Label name="repair-tab-key" text="LB" class="key-badge" picking-mode="Ignore" />
                    <ui:Label text="Repair" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="refit-tab" class="maintenance-tab active-tab">
                    <ui:Label text="Refit" picking-mode="Ignore" />
                    <ui:Label name="refit-tab-key" text="RB" class="key-badge" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement name="tab-selection" class="maintenance-tab-selection" picking-mode="Ignore">
                    <ui:VisualElement name="tab-selection-border" class="maintenance-tab-selection-border" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="refit-content" class="refit-content" picking-mode="Ignore">
                <ui:Label name="refit-checkpoint" class="refit-checkpoint" picking-mode="Ignore" />
                <ui:VisualElement class="refit-slot-navigation">
                    <ui:Label text="BODY SLOTS" class="refit-eyebrow refit-nav-heading" />
                    <ui:Button name="refit-slot-0" text="LEGS" class="refit-slot refit-selected" />
                    <ui:Button name="refit-slot-1" text="CAMERA" class="refit-slot" />
                    <ui:Button name="refit-slot-2" text="BACK" class="refit-slot" />
                    <ui:Button name="refit-slot-3" text="EXPANSION" class="refit-slot" />
                </ui:VisualElement>
                <ui:VisualElement class="refit-unit-panel">
                    <ui:VisualElement class="refit-unit-caption">
                        <ui:Label text="R-07 / UNIT PREVIEW" class="refit-eyebrow" />
                        <ui:Label text="CURRENT UNIT" class="refit-preview-mode" />
                    </ui:VisualElement>
                    <ui:Image name="refit-player-preview" class="refit-robot-preview" picking-mode="Ignore" />
                    <refit:RefitMechanicalFrameElement frame-kind="unit" class="refit-unit-brackets" />
                    <ui:Label name="refit-preview-caption" text="CURRENT CONFIGURATION" class="refit-preview-caption" />
                </ui:VisualElement>
                <ui:VisualElement class="refit-module-library">
                    <ui:Label name="refit-library-label" text="LEGS / MODULES" class="refit-eyebrow" />
                    <ui:VisualElement class="refit-module-row">
                        <ui:Button name="refit-module-0" class="refit-module refit-selected">
                            <ui:Label text="01 / INITIAL" class="refit-module-code" />
                            <ui:Label text="TRACKS" class="refit-module-name" />
                            <ui:Label text="INSTALLED" class="refit-module-state" />
                            <refit:RefitModulePreviewElement module-kind="unavailable" class="refit-module-slash" />
                            <ui:VisualElement class="refit-module-rule" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="refit-module-1" class="refit-module refit-module-unavailable">
                            <ui:Label class="refit-module-code" />
                            <ui:Label class="refit-module-name" />
                            <ui:Label class="refit-module-state" />
                            <refit:RefitModulePreviewElement module-kind="unavailable" class="refit-module-slash" />
                            <ui:VisualElement class="refit-module-rule" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="refit-module-2" class="refit-module refit-module-last refit-module-unavailable">
                            <ui:Label class="refit-module-code" />
                            <ui:Label class="refit-module-name" />
                            <ui:Label class="refit-module-state" />
                            <refit:RefitModulePreviewElement module-kind="unavailable" class="refit-module-slash" />
                            <ui:VisualElement class="refit-module-rule" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="refit-detail">
                    <ui:Label name="refit-module-id" text="LEGS / INITIAL ASSEMBLY" class="refit-eyebrow" />
                    <ui:Label name="refit-detail-title" text="TRACKS" class="refit-detail-title" />
                    <ui:Button name="refit-inspect" class="refit-inspection-window" tooltip="Enlarge inspection window">
                        <refit:RefitModulePreviewElement name="refit-inspection-preview" module-kind="tracks" class="refit-inspection-drawing" />
                        <refit:RefitMechanicalFrameElement frame-kind="inspection" class="refit-window-frame" />
                        <ui:Label name="refit-photo-label" text="INSPECTION" class="refit-photo-label" />
                        <ui:Label name="refit-photo-expand" text="+" class="refit-photo-expand" />
                        <ui:Label name="refit-no-data" class="refit-no-data" />
                    </ui:Button>
                    <ui:VisualElement class="refit-description">
                        <ui:Label text="Description" class="refit-description-label" />
                        <ui:Label name="refit-description-text" text="Standard tracked undercarriage. Installed as the unit's initial mobility assembly." class="refit-description-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="refit-equip-area">
                        <ui:Label name="refit-equip-hint" text="INITIAL CONFIGURATION" class="refit-equip-hint" />
                        <ui:Button name="refit-equip" text="INSTALLED" class="refit-equip-button" enabled="false" tooltip="Initial installed assembly" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="repair-content" class="repair-content" picking-mode="Ignore">
                <ui:VisualElement class="repair-gauge repair-integrity-gauge" picking-mode="Ignore">
                    <ui:Label text="INTEGRITY" class="repair-gauge-title" picking-mode="Ignore" />
                    <refit:RefitMechanicalFrameElement frame-kind="unit" class="repair-gauge-frame" />
                    <hud:CircularProgressElement name="repair-integrity-ring" progress="0" show-track="true" line-width="6" notch-depth="36" class="repair-gauge-ring" />
                    <ui:Label name="repair-integrity" text="—" class="repair-gauge-number" picking-mode="Ignore" />
                    <ui:Label text="CURRENT" class="repair-gauge-caption" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="repair-gauge repair-power-gauge" picking-mode="Ignore">
                    <ui:Label text="POWER" class="repair-gauge-title" picking-mode="Ignore" />
                    <refit:RefitMechanicalFrameElement frame-kind="unit" class="repair-gauge-frame" />
                    <hud:CircularProgressElement name="repair-power-ring" progress="0" show-track="true" outside="true" length="18" line-width="6" class="repair-gauge-ring" />
                    <ui:Label name="repair-power" text="—" class="repair-gauge-number" picking-mode="Ignore" />
                    <ui:Label text="CURRENT" class="repair-gauge-caption" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="repair-after-row" picking-mode="Ignore">
                    <ui:Label text="AFTER REPAIR" class="repair-row-caption" />
                    <ui:Label name="repair-after" text="—" class="repair-row-number repair-after-value" />
                </ui:VisualElement>
                <ui:VisualElement class="repair-divider" picking-mode="Ignore" />
                <ui:VisualElement class="repair-materials" picking-mode="Ignore">
                    <ui:VisualElement class="repair-material-heading" picking-mode="Ignore">
                        <ui:VisualElement class="repair-icon-frame" picking-mode="Ignore">
                            <ui:Image name="repair-icon" class="repair-material-icon" scale-mode="ScaleToFit" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="Metal Scrap" class="repair-material-title" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="repair-ledger" picking-mode="Ignore">
                        <ui:VisualElement class="repair-row">
                            <ui:Label text="CARGO" class="repair-row-caption" />
                            <ui:Label name="repair-cargo" text="—" class="repair-row-number" />
                        </ui:VisualElement>
                        <ui:VisualElement class="repair-row">
                            <ui:Label text="STORAGE" class="repair-row-caption" />
                            <ui:Label name="repair-storage" text="—" class="repair-row-number" />
                        </ui:VisualElement>
                        <ui:VisualElement class="repair-row repair-total-row">
                            <ui:Label text="TOTAL AVAILABLE" class="repair-row-caption" />
                            <ui:Label name="repair-total" text="—" class="repair-row-number" />
                        </ui:VisualElement>
                        <ui:VisualElement class="repair-row">
                            <ui:Label text="REPAIR COST" class="repair-row-caption" />
                            <ui:Label name="repair-cost" text="—" class="repair-row-number repair-cost-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="repair-row">
                            <ui:Label text="REMAINING" class="repair-row-caption" />
                            <ui:Label name="repair-remaining" text="—" class="repair-row-number" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="repair-confirm" class="repair-confirm" enabled="false">
                        <archive:ArchiveHoldCircleElement name="repair-hold" text="A" class="repair-hold" picking-mode="Ignore" />
                        <ui:Label text="HOLD TO REPAIR" class="repair-confirm-caption" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label name="repair-message" class="repair-message" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="refit-footer" class="refit-footer">
                <ui:Label text="Q / E   SWITCH PAGE" class="refit-footer-note" />
                <ui:VisualElement class="refit-controls">
                    <ui:VisualElement name="refit-footer-actions" class="refit-footer-actions">
                        <ui:Label text="UP / DOWN   SLOT" class="refit-control-hint" />
                        <ui:Label text="LEFT / RIGHT   MODULE" class="refit-control-hint" />
                        <ui:Button name="refit-equip-footer" text="A / ENTER   EQUIP" class="refit-footer-button" />
                        <ui:VisualElement name="refit-inspect-help">
                            <ui:Button name="refit-inspect-footer" text="X / I   INSPECT" class="refit-footer-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="refit-close" text="B / ESC   BACK" class="refit-footer-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="refit-inspection-modal" class="refit-inspection-modal">
                <ui:VisualElement class="refit-modal-header">
                    <ui:VisualElement>
                        <ui:Label name="refit-modal-code" text="LEGS / INITIAL ASSEMBLY" class="refit-eyebrow" />
                        <ui:Label name="refit-modal-title" text="TRACKS" class="refit-modal-title" />
                    </ui:VisualElement>
                    <ui:Button name="refit-inspection-close" text="B / ESC   CLOSE" class="refit-footer-button refit-modal-close" />
                </ui:VisualElement>
                <ui:VisualElement class="refit-modal-image">
                    <refit:RefitModulePreviewElement name="refit-modal-preview" module-kind="tracks" class="refit-inspection-drawing" />
                    <refit:RefitMechanicalFrameElement frame-kind="inspection" class="refit-window-frame" />
                    <ui:Label name="refit-modal-no-data" class="refit-modal-no-data" />
                </ui:VisualElement>
                <ui:Label name="refit-modal-caption" text="Standard tracked undercarriage." class="refit-modal-caption" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
